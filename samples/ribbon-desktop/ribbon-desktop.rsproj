<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!-- The ribbon sample (vskubuno docs/RIBBON.md), made from the Kubuno Desktop Application template. -->
  <PropertyGroup>
    <CargoPackage>ribbon-desktop</CargoPackage>
    <KubunoDesktopSrc Condition="'$(KubunoDesktopSrc)' == ''">Z:\src\core\desktop</KubunoDesktopSrc>
    <KubunoDesktopCrates Condition="'$(KubunoDesktopCrates)' == ''">$(KubunoDesktopSrc)\windows</KubunoDesktopCrates>
    <!-- Its own cargo target directory (see the template's comment). -->
    <CargoTargetDir Condition="'$(CARGO_TARGET_DIR)' != ''">$(CARGO_TARGET_DIR)\rsproj\$(CargoPackage)</CargoTargetDir>
    <CargoTargetDir Condition="'$(CARGO_TARGET_DIR)' == ''">$(MSBuildProjectDirectory)\target</CargoTargetDir>
  </PropertyGroup>

  <Target Name="KubunoCheckDesktopSources" BeforeTargets="CargoRestore;CoreCompile">
    <Error Condition="!Exists('$(KubunoDesktopCrates)/kubuno-desktop-ui/Cargo.toml')"
           Code="KUBUNO0001"
           Text="The Kubuno desktop sources were not found at '$(KubunoDesktopCrates)'. Point &lt;KubunoDesktopCrates&gt; in this .rsproj and the kubuno-desktop path in Cargo.toml at the desktop/windows folder of a checkout of github.com/kubuno/core." />
  </Target>

</Project>

