<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!--
    Manually-written .rsproj verifying Kubuno.Rust.Sdk (docs/RSPROJ.md work packages 1-2) against
    the same samples/hello-rust fixture the Open Folder integration already uses. Resolved from
    samples/NuGet.config's local feed — see README.md's "Building Rust with MSBuild (.rsproj)"
    section for how to build that feed (no Marketplace/NuGet.org publish exists yet).
  -->
  <PropertyGroup>
    <CargoPackage>hello-rust</CargoPackage>
  </PropertyGroup>

</Project>
