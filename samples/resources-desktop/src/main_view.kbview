<!--
  The resources sample's window: every text, picture and the accent colour is a {Res key} of
  src/resources.kbres (Visual Studio's designer shows them, in the language chosen in its tab strip).
-->
<Panel DesignWidth="640" DesignHeight="400" Title="{Res app_title}" Icon="{Res app_icon}" OnLoad="main_view_load">
  <Panel x:Name="banner" BackgroundImage="{Res banner}" BackgroundImageLayout="Stretch" X="40" Y="24" Width="560" Height="96"/>
  <PictureBox x:Name="logo" Image="{Res logo}" SizeMode="Zoom" X="40" Y="140" Width="64" Height="64"/>
  <Label x:Name="welcome" Text="{Res welcome_text}" ForeColor="{Res accent}" Font="Segoe UI, 12pt, style=Bold" X="120" Y="140" Width="480" Height="24"/>
  <Label x:Name="hint" Text="{Res hint_text}" X="120" Y="172" Width="480" Height="40"/>
  <Button x:Name="switch_culture" Text="{Res switch_text}" Icon="{Res app_icon}" OnClick="switch_culture_click" X="40" Y="256" Width="160" Height="36"/>
  <Button x:Name="ok" Text="{Res ok_text}" Variant="Primary" OnClick="ok_click" X="480" Y="256" Width="120" Height="36"/>
  <Label x:Name="status" Text="" X="40" Y="316" Width="560" Height="20"/>
</Panel>
