<!--
  One message of the foundations sample's thread: the item template of the Repeater (ItemTemplate="MessageRow").
  Its bindings read the row of the item first (Author, Text, Time, Presence), then the user control's own
  properties (Likes); its handlers are MessageRow's methods.
-->
<UserControl x:Class="MessageRow" DesignWidth="420" DesignHeight="64">
  <Avatar x:Name="avatar" DisplayName="{Binding Author}" Presence="{Binding Presence}" AvatarSize="40" X="12" Y="12" Width="40" Height="40"/>
  <Label x:Name="author" Text="{Binding Author}" Role="Heading" X="64" Y="10" Width="200" Height="20" Anchor="Top, Left, Right"/>
  <Label x:Name="time" Text="{Binding Time}" Role="Meta" TextAlign="TopRight" X="276" Y="12" Width="92" Height="18" Anchor="Top, Right"/>
  <Label x:Name="text" Text="{Binding Text}" X="64" Y="32" Width="272" Height="22" Anchor="Top, Left, Right"/>
  <Label x:Name="likes" Text="{Binding Likes}" Role="Meta" TextAlign="TopRight" X="336" Y="34" Width="32" Height="18" Anchor="Top, Right"/>
  <IconButton x:Name="like" Icon="Heart" Diameter="32" Glyph="16" ToolTip="J'aime" OnClick="like_click" X="376" Y="16" Width="32" Height="32" Anchor="Top, Right"/>
</UserControl>
