<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Local feed for Kubuno.Rust.Sdk (docs/RSPROJ.md work packages 1-2) until it is ever published.
    Build the package first (see README.md's "Building Rust with MSBuild (.rsproj)" section):
      dotnet pack sdk\Kubuno.Rust.Sdk\Kubuno.Rust.Sdk.csproj -c Release -o C:\kubuno-build\nuget-local-feed
    NuGet restores it into the local machine's package cache from there, which is why this must be
    a real NuGet source rather than a bare `Sdk="…"` path import: this repo lives on a mapped
    network drive (Z:), and loading the SDK's task assembly directly from Z: fails under
    `dotnet build` — see Kubuno.Rust.Sdk.csproj's own comment for the full story.
  -->
  <packageSources>
    <clear />
    <add key="kubuno-local" value="C:\kubuno-build\nuget-local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
