<?xml version="1.0" encoding="utf-8"?>
<!--
  Image manifest for the .rsproj project node icon (docs/RSPROJ.md §3) and the .rs/.kbview/Cargo.toml file icons (lot 8). Shipped at the root of the
  Kubuno.VisualStudio VSIX, where Visual Studio's image service discovers *.imagemanifest files on
  its own (no registration needed). The XAML sources are WPF resources of
  Kubuno.VisualStudio.RustProjectSystem.dll; the GUID/ID must match RustProjectImages.cs.
-->
<ImageManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/VisualStudio/ImageManifestSchema/2014">
  <Symbols>
    <String Name="Resources" Value="/Kubuno.VisualStudio.RustProjectSystem;Component/Resources" />
    <Guid Name="RustProjectImagesGuid" Value="{7d2b8c4e-5a1f-4e63-9b0d-3c6f2a8e1b57}" />
    <ID Name="RustProject" Value="1" />
    <ID Name="RustFile" Value="2" />
    <ID Name="KbviewFile" Value="3" />
    <ID Name="CargoManifest" Value="4" />
  </Symbols>
  <Images>
    <!-- Official Rust gear+R mark, one XAML per background AND per size: the 16px variant drops the
         32 cog teeth (illegible once rasterised that small), the 32px+ variant keeps the full gear. -->
    <Image Guid="$(RustProjectImagesGuid)" ID="$(RustProject)" AllowColorInversion="false">
      <Source Uri="$(Resources)/Icons/RustProject.Small.Light.xaml" Background="Light">
        <Size Value="16" />
      </Source>
      <Source Uri="$(Resources)/Icons/RustProject.Small.Dark.xaml" Background="Dark">
        <Size Value="16" />
      </Source>
      <Source Uri="$(Resources)/Icons/RustProject.Small.HighContrast.xaml" Background="HighContrast">
        <Size Value="16" />
      </Source>
      <Source Uri="$(Resources)/Icons/RustProject.Large.Light.xaml" Background="Light">
        <Size Value="32" />
      </Source>
      <Source Uri="$(Resources)/Icons/RustProject.Large.Dark.xaml" Background="Dark">
        <Size Value="32" />
      </Source>
      <Source Uri="$(Resources)/Icons/RustProject.Large.HighContrast.xaml" Background="HighContrast">
        <Size Value="32" />
      </Source>
    </Image>
    <!-- lot 8: vector file icon, one XAML per background (no colour inversion needed). -->
    <Image Guid="$(RustProjectImagesGuid)" ID="$(RustFile)" AllowColorInversion="false">
      <Source Uri="$(Resources)/Icons/RustFile.Light.xaml" Background="Light" />
      <Source Uri="$(Resources)/Icons/RustFile.Dark.xaml" Background="Dark" />
      <Source Uri="$(Resources)/Icons/RustFile.HighContrast.xaml" Background="HighContrast" />
    </Image>
    <!-- lot 8: vector file icon, one XAML per background (no colour inversion needed). -->
    <Image Guid="$(RustProjectImagesGuid)" ID="$(KbviewFile)" AllowColorInversion="false">
      <Source Uri="$(Resources)/Icons/KbviewFile.Light.xaml" Background="Light" />
      <Source Uri="$(Resources)/Icons/KbviewFile.Dark.xaml" Background="Dark" />
      <Source Uri="$(Resources)/Icons/KbviewFile.HighContrast.xaml" Background="HighContrast" />
    </Image>
    <!-- lot 8: vector file icon, one XAML per background (no colour inversion needed). -->
    <Image Guid="$(RustProjectImagesGuid)" ID="$(CargoManifest)" AllowColorInversion="false">
      <Source Uri="$(Resources)/Icons/CargoManifest.Light.xaml" Background="Light" />
      <Source Uri="$(Resources)/Icons/CargoManifest.Dark.xaml" Background="Dark" />
      <Source Uri="$(Resources)/Icons/CargoManifest.HighContrast.xaml" Background="HighContrast" />
    </Image>
  </Images>
  <ImageLists />
</ImageManifest>
