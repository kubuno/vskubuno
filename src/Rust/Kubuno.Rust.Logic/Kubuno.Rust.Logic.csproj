<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rust layer, pure logic (docs/ARCHITECTURE.md, "Layers (as built)"): what Kubuno.Rust and
    Kubuno.Rust.ProjectSystem compute without Visual Studio (rust-analyzer discovery and handshake, completion and
    hover presentation, .rsproj generation and properties, the Dependencies tree, test location, startup items).
    No dependency on the VS SDK, so it is unit-tested with plain `dotnet test` (tests/Kubuno.Rust.Tests).
    Nothing here knows a Kubuno target (desktop views, web modules, mobile apps): those live in the layers above.
    Targets net48 to match the in-proc extension's runtime (classic VSSDK extensions are .NET Framework 4.8).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Kubuno.Rust.Logic</RootNamespace>
    <AssemblyName>Kubuno.Rust.Logic</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- StartupItemSelector needs Kubuno.Rust.Cargo's CargoPackage/CargoTarget metadata model - still no VS SDK dependency, so plain `dotnet test` keeps working. -->
    <ProjectReference Include="..\Kubuno.Rust.Cargo\Kubuno.Rust.Cargo.csproj" />
    <ProjectReference Include="..\..\Shared\Kubuno.Shared.Logic\Kubuno.Shared.Logic.csproj" />
  </ItemGroup>

</Project>
