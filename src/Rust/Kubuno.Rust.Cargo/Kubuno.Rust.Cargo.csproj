<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure, VS-independent Cargo brain for the extension: cargo metadata / build-message
    parsing, a command-line builder and a mockable process runner. Targets netstandard2.0
    so the .NET Framework 4.8 VSIX project (Kubuno.VisualStudio) can reference it directly,
    while still being testable with plain `dotnet test` on any modern SDK.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Kubuno.Rust.Cargo</RootNamespace>
    <AssemblyName>Kubuno.Rust.Cargo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      netstandard2.0 has no built-in JSON support; the package ships its own implementation.
      Pinned to 9.0.0 - not the latest 8.0.x - to match the version Microsoft.VisualStudio.SDK's
      own net462 dependency closure already resolves to (see Kubuno.VisualStudio.csproj's own
      PackageReference comment): pinning below that floor made NuGet's own version-unification
      report a downgrade (NU1605) on every build of Kubuno.VisualStudio.csproj, a legacy-format
      csproj where that is a warning rather than a build error, but still worth fixing at the
      source rather than leaving standing.
    -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
