<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MSBuild tasks (CargoBuild/CargoTest/CargoFetch) that drive Kubuno.Rust.Cargo from a .rsproj build
    (see docs/RSPROJ.md work package 2). A custom task assembly must load in BOTH the classic,
    .NET Framework MSBuild.exe that ships inside Visual Studio AND the .NET (Core) host
    `dotnet build`/`dotnet msbuild` uses.

    Multi-targeted net472/net10.0 (net10.0 matching this workspace's installed SDK exactly, same
    as tests/Kubuno.Rust.Cargo.Tests.csproj), selected in Sdk.targets by $(MSBuildRuntimeType) — the
    approach docs/RSPROJ.md §2 originally called for (it assumed Kubuno.Rust.Cargo was net48, which
    turned out false, but the "selected by $(MSBuildRuntimeType)" split itself was right).

    Getting `dotnet build` to load this in process took a detour worth recording: it first failed
    with MSB4061 "Type must be a type provided by the runtime.", which looks exactly like a
    Runtime/Architecture or TFM mismatch (and MSBuild's own warning suggests as much) — netstandard2.0
    alone, then net8.0, then explicit Runtime="NET"/Architecture="x64" `<UsingTask>` hints were all
    tried and none of it changed the failure. A minimal repro assembly (same task classes, same
    Kubuno.Rust.Cargo/Kubuno.Rust.Launch references, same net10.0 TFM) loaded fine, isolating the real
    variable to WHERE the assembly was loaded from: this workspace sits on a mapped network drive
    (Z:), and `dotnet build` refuses to load a task assembly from there in process — the same class
    of loader-from-remote-source restriction README.md's "Tests" section already documents for
    MSTest, just surfacing as this far more confusing error for MSBuild's own task loader instead
    of a clear FileLoadException. The actual fix is distributing this SDK as a NuGet package (see
    Kubuno.Rust.Sdk.csproj's own comment): NuGet restores packages into the local machine's cache
    (always on C:) regardless of where the referencing project lives, so Sdk.targets'
    $(_KubunoCargoTasksAssembly) never points at Z: for a real consumer. No Runtime/Architecture
    hint on <UsingTask> is needed once that is true.
  -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Kubuno.Cargo.MSBuild.Tasks</RootNamespace>
    <AssemblyName>Kubuno.Cargo.MSBuild.Tasks</AssemblyName>
    <!-- Not needed for the net472 leg (the classic Framework host has no such requirement); see
         Sdk.props/Sdk.targets' own comments for why the net10.0 leg's .deps.json turned out to be
         unrelated to the Z:-drive failure above, but it is still correct to generate/ship it. -->
    <GenerateDependencyFile Condition="'$(TargetFramework)' == 'net472'">false</GenerateDependencyFile>
    <!--
      A class library TFM does not copy transitive package references to its own output by
      default. A Framework host (MSBuild.exe) has no other way to find this assembly's own
      managed dependencies (System.Text.Json's closure for the net472 leg), so they must land
      right next to it.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!--
      NU1903: every currently published Microsoft.Build.Utilities.Core version reports the same
      known advisory (GHSA-w3q9-fxm7-j8fq); Microsoft ships the fix in-box with Visual Studio/the
      .NET SDK rather than by reissuing this NuGet package, so no available version resolves it.
      This package is compile-time-only (ExcludeAssets="runtime" below) and never shipped.
    -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Supplied by both hosts at run time (MSBuild.exe and dotnet's own bundled MSBuild already
      have these types loaded); referenced here only to compile against, never copied or shipped
      — the standard shape for a cross-host custom-task package.
    -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.8" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kubuno.Rust.Cargo\Kubuno.Rust.Cargo.csproj" />
    <ProjectReference Include="..\Kubuno.Rust.Launch\Kubuno.Rust.Launch.csproj" />
  </ItemGroup>

</Project>
