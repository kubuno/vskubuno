<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Visual Studio debugger engine (Concord) component shipped inside the Kubuno.VisualStudio VSIX
    (docs/DEBUGGING.md): it turns the C++ exception every Rust panic raises on MSVC (`rust_panic`) into a
    readable "Rust panic: <message>" in the exception helper and the Output window, by reading the panic
    payload out of the debuggee. Built into a .vsdconfig by the VSDConfigTool package's own targets
    (VsdConfigXmlFiles item below); registered by the VSIX manifest's DebuggerEngineExtension asset.

    Self-contained on purpose: Concord loads this assembly from the .vsdconfig's folder, possibly in a
    remote-debugger worker process, so it references nothing of the extension but the debugger engine
    API itself (taken from the running Visual Studio install, never shipped - like CPS in
    Kubuno.VisualStudio.RustProjectSystem).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.VisualStudio.Debugger</RootNamespace>
    <AssemblyName>Kubuno.VisualStudio.Debugger</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <KubunoVsInstallDir Condition="'$(KubunoVsInstallDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)\..\..\..'))\</KubunoVsInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualStudio.Debugger.Engine">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\Microsoft.VisualStudio.Debugger.Engine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Compiles Kubuno.VisualStudio.Debugger.vsdconfigxml into $(OutDir)Kubuno.VisualStudio.Debugger.vsdconfig and
         adds it to BuiltProjectOutputGroup, so the VSIX picks it up with the assembly. -->
    <PackageReference Include="Microsoft.VSSDK.Debugger.VSDConfigTool" Version="17.14.1051801" PrivateAssets="all" />
    <VsdConfigXmlFiles Include="Kubuno.VisualStudio.Debugger.vsdconfigxml" />
  </ItemGroup>

</Project>
