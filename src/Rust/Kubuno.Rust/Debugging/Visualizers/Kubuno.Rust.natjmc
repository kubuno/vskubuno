<?xml version="1.0" encoding="utf-8"?>
<!--
  Kubuno for Visual Studio - "Just My Code" for Rust (docs/DEBUGGING.md). Installed by the extension into
  %USERPROFILE%\Documents\<Visual Studio version>\Visualizers (the only per-user place Visual Studio reads .natjmc
  files from) and refreshed on every Rust debug launch; delete it there to see the standard library as user code.

  With Tools > Options > Debugging > "Enable Just My Code" on (the default):
  - the Call Stack collapses the Rust standard library into [External Code] (right-click > Show External Code);
  - a panic (the " ?? ::st_panic" entry of Exception Settings > C++ Exceptions) is shown at the user's line that
    panicked (`v[i]`, `x.unwrap()`), not inside the standard library: every standard-library function is an
    ExceptionImplementation, like _CxxThrowException/RaiseException in Visual Studio's own default.natjmc, so the
    exception is attributed to the first user frame that called into the library, as .NET does.
  Stepping is not affected (that needs the MSVC /JMC switch, which rustc has no equivalent of): stepping over the
  standard library is Kubuno.Rust.natstepfilter's job.

  The file applies to every native debug session of this user, C++ included: `std::` is matched by the Rust standard
  library's own module names only, so the C++ standard library keeps its usual Just My Code treatment.
-->
<NonUserCode xmlns="http://schemas.microsoft.com/vstudio/debugger/jmc/2015">
  <!-- `-C prefer-dynamic` builds (the Kubuno desktop apps) load the standard library as std-<hash>.dll. -->
  <Module Name="*\std-*.dll" />

  <!-- The panic machinery, from the panicking call (unwrap, indexing, panic!) down to the C++ throw. -->
  <Function Name="core::panicking::*" ExceptionImplementation="true" />
  <Function Name="core::option::unwrap_failed" ExceptionImplementation="true" />
  <Function Name="core::option::expect_failed" ExceptionImplementation="true" />
  <Function Name="core::result::unwrap_failed" ExceptionImplementation="true" />
  <Function Name="core::slice::index::*" ExceptionImplementation="true" />
  <Function Name="core::str::slice_error_fail*" ExceptionImplementation="true" />
  <Function Name="core::cell::panic_already_*" ExceptionImplementation="true" />
  <Function Name="std::panicking::*" ExceptionImplementation="true" />
  <Function Name="std::panic::*" ExceptionImplementation="true" />
  <Function Name="std::sys::backtrace::__rust_end_short_backtrace*" ExceptionImplementation="true" />
  <Function Name="std::rt::*" ExceptionImplementation="true" />
  <Function Name="panic_unwind::*" ExceptionImplementation="true" />
  <Function Name="rust_begin_unwind" ExceptionImplementation="true" />
  <Function Name="__rust_start_panic" ExceptionImplementation="true" />
  <Function Name="rust_panic" ExceptionImplementation="true" />

  <!-- The rest of the standard library (its generic code - Vec's Index, Option::unwrap... - is instantiated in the
       user's own modules). -->
  <Function Name="core::*" ExceptionImplementation="true" />
  <Function Name="alloc::*" ExceptionImplementation="true" />
  <Function Name="std::alloc::*" ExceptionImplementation="true" />
  <Function Name="std::array::*" ExceptionImplementation="true" />
  <Function Name="std::ascii::*" ExceptionImplementation="true" />
  <Function Name="std::async_iter::*" ExceptionImplementation="true" />
  <Function Name="std::backtrace::*" ExceptionImplementation="true" />
  <Function Name="std::backtrace_rs::*" ExceptionImplementation="true" />
  <Function Name="std::borrow::*" ExceptionImplementation="true" />
  <Function Name="std::boxed::*" ExceptionImplementation="true" />
  <Function Name="std::bstr::*" ExceptionImplementation="true" />
  <Function Name="std::cell::*" ExceptionImplementation="true" />
  <Function Name="std::char::*" ExceptionImplementation="true" />
  <Function Name="std::clone::*" ExceptionImplementation="true" />
  <Function Name="std::cmp::*" ExceptionImplementation="true" />
  <Function Name="std::collections::*" ExceptionImplementation="true" />
  <Function Name="std::convert::*" ExceptionImplementation="true" />
  <Function Name="std::default::*" ExceptionImplementation="true" />
  <Function Name="std::env::*" ExceptionImplementation="true" />
  <Function Name="std::error::*" ExceptionImplementation="true" />
  <Function Name="std::f16::*" ExceptionImplementation="true" />
  <Function Name="std::f32::*" ExceptionImplementation="true" />
  <Function Name="std::f64::*" ExceptionImplementation="true" />
  <Function Name="std::f128::*" ExceptionImplementation="true" />
