  <Function Name="std::thread::main_thread*" ExceptionImplementation="true" />
  <Function Name="std::thread::impl$*" ExceptionImplementation="true" />
  <Function Name="std::any::type_name*" ExceptionImplementation="true" />
  <Function Name="std::any::type_name_of_val*" ExceptionImplementation="true" />
  <Function Name="std::any::TypeId*" ExceptionImplementation="true" />
  <Function Name="std::any::impl$*" ExceptionImplementation="true" />
  <Function Name="enum2$&lt;core::*" ExceptionImplementation="true" />
  <Function Name="enum2$&lt;alloc::*" ExceptionImplementation="true" />
  <Function Name="enum2$&lt;std::*" ExceptionImplementation="true" />
</NonUserCode>