  <Function Name="std::sys_common::*" ExceptionImplementation="true" />
  <Function Name="std::task::*" ExceptionImplementation="true" />
  <Function Name="std::time::*" ExceptionImplementation="true" />
  <Function Name="std::vec::*" ExceptionImplementation="true" />
  <Function Name="std::thread::spawn*" ExceptionImplementation="true" />
  <Function Name="std::thread::Builder*" ExceptionImplementation="true" />
  <Function Name="std::thread::scope*" ExceptionImplementation="true" />
  <Function Name="std::thread::scoped*" ExceptionImplementation="true" />
  <Function Name="std::thread::sleep*" ExceptionImplementation="true" />
  <Function Name="std::thread::sleep_ms*" ExceptionImplementation="true" />
  <Function Name="std::thread::sleep_until*" ExceptionImplementation="true" />
