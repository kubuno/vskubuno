  <Function Name="std::thread::park_timeout*" ExceptionImplementation="true" />
  <Function Name="std::thread::yield_now*" ExceptionImplementation="true" />
  <Function Name="std::thread::available_parallelism*" ExceptionImplementation="true" />
  <Function Name="std::thread::local*" ExceptionImplementation="true" />
  <Function Name="std::thread::lifecycle*" ExceptionImplementation="true" />
  <Function Name="std::thread::functions*" ExceptionImplementation="true" />
