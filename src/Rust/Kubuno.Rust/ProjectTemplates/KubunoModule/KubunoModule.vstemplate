<?xml version="1.0" encoding="utf-8"?>
<!--
  docs/RSPROJ.md Addendum (lot 7): "Kubuno Module" - a backend module skeleton following the Kubuno
  module conventions (vskubuno's own CLAUDE.md, referencing the platform's CLAUDE.md section 4/7:
  a separate Axum 0.7/Tokio process, SQLx/PostgreSQL with a schema dedicated to this module,
  module.toml, port allocation, /internal/* guarded by X-Internal-Secret, zero unwrap(), tracing,
  security headers). Mirrors a real small module's layout (notes/tasks: Cargo.toml with a
  git-tagged kubuno-seccomp dependency, module.toml, src/main.rs, migrations/, build_kbpkg.sh,
  CHANGELOG.md, README.md) trimmed to a minimal, buildable-on-this-machine starting point - see
  each generated file's own comments for what was simplified and why.
-->
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Kubuno Module</Name>
    <Description>A Kubuno backend module (deploys to Linux, developed here on Windows): Axum/Tokio server, SQLx/PostgreSQL migrations, module.toml and build_kbpkg.sh, built through Cargo as a real MSBuild/CPS project (.rsproj).</Description>
    <ProjectType>Rust</ProjectType>
    <TemplateID>Kubuno.Rust.KubunoModule</TemplateID>
    <LanguageTag>Rust</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Kubuno</ProjectTypeTag>
    <Icon>__TemplateIcon.png</Icon>
    <SortOrder>40</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>KubunoModule</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <CreateInPlace>true</CreateInPlace>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.rsproj" File="ProjectTemplate.rsproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="Cargo.toml">Cargo.toml</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="module.toml">module.toml</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="config.toml.example">config.toml.example</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="README.md">README.md</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="CHANGELOG.md">CHANGELOG.md</ProjectItem>
      <!--
        Generic, self-detecting bash script (reads id/version from module.toml/Cargo.toml at run
        time - see its own header comment) - copied byte-identical rather than run through VS's
        template-parameter substitution. Deliberate: it is written in French with accented
        characters, and docs/RSPROJ.md Addendum (lot 7)'s own "Template content is ASCII-only" note
        found that VS reads a ReplaceParameters="true" content file through an ANSI code page with
        no BOM, turning non-ASCII bytes into mojibake. ReplaceParameters="false" copies the file
        as-is instead, since it has no $token$ to substitute anyway.
      -->
      <ProjectItem ReplaceParameters="false" TargetFileName="build_kbpkg.sh">build_kbpkg.sh</ProjectItem>
      <Folder Name="src" TargetFolderName="src">
        <ProjectItem ReplaceParameters="true" TargetFileName="main.rs">main.rs</ProjectItem>
      </Folder>
      <Folder Name="migrations" TargetFolderName="migrations">
        <Folder Name="postgres" TargetFolderName="postgres">
          <ProjectItem ReplaceParameters="true" TargetFileName="000001_init.up.sql">000001_init.up.sql</ProjectItem>
          <ProjectItem ReplaceParameters="true" TargetFileName="000001_init.down.sql">000001_init.down.sql</ProjectItem>
        </Folder>
      </Folder>
    </Project>
  </TemplateContent>
  <!-- Kubuno.Rust.TemplateWizard/$cratename$+$moduleid$ - see RustConsoleApplication.vstemplate's own remarks. -->
  <WizardExtension>
    <Assembly>Kubuno.Rust.TemplateWizard, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>Kubuno.Rust.TemplateWizard.CrateNameWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
