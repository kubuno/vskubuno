; Rust layer (docs/ARCHITECTURE.md, "Layers (as built)"). Registers the Grammars folder shipped in this VSIX as a
; TextMate repository, so .rs files get syntax coloring from rust.tmLanguage.json even before (or without)
; rust-analyzer running. The .kbview grammar of the desktop layer has its own kbview-languages.pkgdef.
[$RootKey$\TextMate\Repositories]
"Kubuno"="$PackageFolder$\Grammars"

; Brackets/comments/indentation for the grammar's scope (source.rust) and for the LSP content type (rust, see
; LanguageService\ContentDefinition.cs) - both keys point at the same file.
[$RootKey$\TextMate\LanguageConfiguration\GrammarMapping]
"source.rust"="$PackageFolder$\Grammars\rust-language-configuration.json"

[$RootKey$\TextMate\LanguageConfiguration\ContentTypeMapping]
"rust"="$PackageFolder$\Grammars\rust-language-configuration.json"

; docs/RSPROJ.md lot 8: file icons by extension, from Kubuno.Rust.ProjectSystem's RustProject.imagemanifest
; (guid:id, the same format VS's own ModelBuilder icons.pkgdef uses). Used by Solution Explorer wherever no
; project system sets an icon itself - notably Open Folder; .rsproj items get the same monikers from
; RustProjectTreePropertiesProvider. Cargo.toml is not associated here: the key is per extension, and every
; other .toml file would get the Cargo icon too.
[$RootKey$\ShellFileAssociations\.rs]
"DefaultIconMoniker"="7d2b8c4e-5a1f-4e63-9b0d-3c6f2a8e1b57:2"
