<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared layer (docs/ARCHITECTURE.md, "Layers (as built)"). Standalone MCP server process (kubuno-vs-mcp.exe once packaged - see docs/MCP.md "Packaging").
    Targets net8.0 (an installed LTS runtime, same choice already made for
    tests/Kubuno.Rust.Launch.Tests - see that project's csproj comment) rather than net48: this process
    never runs in-proc in devenv.exe, so nothing ties it to .NET Framework, and net8.0 lets it use
    the current `ModelContextProtocol` SDK and a plain `dotnet publish` self-contained exe.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Kubuno.Shared.Mcp</RootNamespace>
    <AssemblyName>kubuno-vs-mcp</AssemblyName>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The official C# MCP SDK (see docs/MCP.md "Why the ModelContextProtocol SDK" for why a
      hand-written JSON-RPC layer was rejected): stdio transport, tool discovery via
      [McpServerToolType]/[McpServerTool], and a real MCP client (used only by
      tests/Kubuno.Shared.Mcp.Tests, not shipped here) all come from this one package.
    -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- net8.0 flavor only: DTOs, pipe client, framing and discovery-file reader - no EnvDTE. -->
    <ProjectReference Include="..\Kubuno.Shared.Mcp.Bridge\Kubuno.Shared.Mcp.Bridge.csproj" />
  </ItemGroup>

</Project>
