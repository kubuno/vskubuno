<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared layer, pure logic (docs/ARCHITECTURE.md, "Layers (as built)"): helpers every product layer may use and that
    need no Visual Studio SDK - LSP plumbing (handshake streams, JSON, snippets), the hover markdown model, the UI
    language. No dependency on the VS SDK, so plain `dotnet test` exercises it (tests/Kubuno.Shared.Tests).
    net48 like the rest of the in-proc extension (classic VSSDK extensions are .NET Framework 4.8).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Kubuno.Shared.Logic</RootNamespace>
    <AssemblyName>Kubuno.Shared.Logic</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- LspJson: .NET Framework has no built-in System.Text.Json. Same version as the rest of the extension. -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
