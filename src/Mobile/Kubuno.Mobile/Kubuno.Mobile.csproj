<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mobile layer (docs/ARCHITECTURE.md, "Layers (as built)", "Roadmap - Kubuno mobile apps in the same VSIX" and
    "Roadmap - Kubuno view rendering engine for mobile"): the Visual Studio side of Kubuno MOBILE apps (Android, iOS,
    iPadOS) - Gradle/Kotlin projects, devices, and the portable Rust rendering engine with its Pair-to-Mac build
    host. Today a skeleton: MobileLayer is already registered with the package (src/Kubuno.VisualStudio) through the
    same contract as the Rust and Desktop layers (Kubuno.Core.Extensibility.KubunoLayer), with no feature yet - see
    README.md for what goes here and where each piece plugs in.

    References Kubuno.Core and the Rust layer only - never Kubuno.Desktop or Kubuno.Web (enforced by
    tests/Kubuno.Architecture.Tests). Desktop code the mobile renderer will share (the .kbview designer, the view
    registry) must first move down into a lower layer, never be referenced sideways.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.Mobile</RootNamespace>
    <AssemblyName>Kubuno.Mobile</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as every other Visual Studio assembly of the extension (bump them together). -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Kubuno.Core\Kubuno.Core.csproj" />
    <ProjectReference Include="..\..\Core\Kubuno.Core.Logic\Kubuno.Core.Logic.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust\Kubuno.Rust.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.Logic\Kubuno.Rust.Logic.csproj" />
  </ItemGroup>

</Project>
