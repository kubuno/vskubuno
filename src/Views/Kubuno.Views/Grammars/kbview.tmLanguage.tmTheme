<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kubuno Views: the colors of this grammar's TextMate scopes, as Visual Studio classification types (Visual Studio loads the
  theme next to a grammar, <grammar>.tmTheme, instead of its global one). Only classification names: the colors
  themselves come from Tools > Options > Fonts and Colors, so they follow the light/dark theme and the user's settings.

  Every name below MUST be a classification type registered through MEF in every Visual Studio session: a name that is
  not (the XML editor's "XML Name"/"XML Attribute"... are legacy colorable items, not classification types; the XAML
  editor's "XAML Markup Extension ..." exist only once that editor is loaded) colors nothing, silently - which is how
  every .kbview lost its colors (2026-10-02). The markup names are the ones Visual Studio's own TextMate theme
  (TextMate\Starterkit\Themes\vs.tmTheme) gives XML and HTML; tests/Kubuno.Views.Tests checks the list.
-->
<plist version="1.0">
  <dict>
    <key>name</key>
    <string>Kubuno Views</string>
    <key>settings</key>
    <array>
      <dict>
        <key>scope</key>
        <string>comment, comment.block.xml, punctuation.definition.comment</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>comment</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>entity.name.tag, entity.name.tag.localname.xml, entity.name.tag.namespace.xml, meta.tag, punctuation.definition.tag, punctuation.separator.namespace.xml</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>markup node</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>entity.other.attribute-name, entity.other.attribute-name.localname.xml, entity.other.attribute-name.namespace.xml</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>markup attribute</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>string.quoted.double.xml, string.quoted.single.xml, punctuation.definition.string.begin.xml, punctuation.definition.string.end.xml, constant.character.entity, punctuation.definition.constant</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>markup attribute value</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>entity.name.function.handler.kbview</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>method name</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>punctuation.section.embedded.binding.kbview, keyword.other.binding.kbview</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>type</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>entity.other.attribute-name.binding.kbview</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>markup attribute</string>
        </dict>
      </dict>
      <dict>
        <key>scope</key>
        <string>variable.other.property.binding.kbview</string>
        <key>settings</key>
        <dict>
          <key>vsclassificationtype</key>
          <string>identifier</string>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
