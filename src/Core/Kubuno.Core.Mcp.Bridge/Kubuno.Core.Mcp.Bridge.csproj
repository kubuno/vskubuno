<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core layer (docs/ARCHITECTURE.md, "Layers (as built)"). Multi-targeted so the SAME contract (DTOs,
    JSON-RPC-ish pipe framing, dispatcher, discovery-file format) is compiled twice:

      - net48:  the flavor Kubuno.Core (in-proc devenv.exe, KubunoLayerHost starts the bridge) loads. Only this
                flavor compiles DteVsContextProvider.cs, because EnvDTE/EnvDTE80 are Framework-only
                COM interop assemblies with no net8.0 assets (see the PackageReference Condition
                below) - pulling them into the net8.0 build would break restore for anything
                referencing this project from net8.0 (notably Kubuno.Core.Mcp and its tests).
      - net8.0: the flavor Kubuno.Core.Mcp (the standalone MCP server exe, net8.0) and
                tests/Kubuno.Core.Mcp.Tests reference. It gets the pipe client, the framing/dispatch
                logic and the discovery-file reader/writer - everything except the DTE-specific
                reference implementation - so the wire contract is never duplicated between the
                exe and the in-proc bridge, and it is unit-testable with plain `dotnet test`
                (see CLAUDE.md: "Mode de dev choisi = publié" doesn't apply to in-repo contracts;
                this is the one place code is intentionally shared as source, not as a published
                artifact, because both flavors ship from the same VSIX release).
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Kubuno.Core.Mcp.Bridge</RootNamespace>
    <AssemblyName>Kubuno.Core.Mcp.Bridge</AssemblyName>
  </PropertyGroup>

  <!-- net8.0 needs no System.Text.Json package: it ships in the shared framework. net48 gets it transitively from Microsoft.VisualStudio.SDK below (see its comment). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!--
      Same package versions as src/Core/Kubuno.Core/Kubuno.Core.csproj, so the in-proc load inside
      devenv.exe binds against the identical EnvDTE/EnvDTE80 surface the rest of the extension uses.
      ExcludeAssets=runtime: at runtime inside devenv.exe these are resolved against the host's own
      copies, never shipped standalone (the VSIX is packaged by src/Kubuno.VisualStudio - see docs/MCP.md).
      PrivateAssets=all: the layers above Kubuno.Core compile against their own Visual Studio references
      (the CPS project systems use the installed 18.x assemblies), so none of these may flow to them.
    -->
    <PackageReference Include="EnvDTE" Version="17.14.40260" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="EnvDTE80" Version="17.14.40260" ExcludeAssets="runtime" PrivateAssets="all" />
    <!--
      Same version as the VSIX's Microsoft.VisualStudio.SDK reference: brings in
      Microsoft.VisualStudio.Shell.ThreadHelper, used to marshal every DTE call in
      DteVsContextProvider.cs onto the main thread (DTE is single-apartment COM; the pipe host
      dispatches requests from a background/thread-pool task - see VsMcpBridgeHost.HandleClientAsync).
      ExcludeAssets=runtime: resolved against the running devenv.exe's own copy, same reasoning as
      the other Visual Studio assemblies of the extension. No direct System.Text.Json PackageReference
      here on purpose: Microsoft.VisualStudio.SDK's own net462 dependency closure already pulls
      System.Text.Json >= 9.0.0, and an explicit downgrade would be a build error (NU1605) in this
      SDK-style project.
    -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- EnvDTE/EnvDTE80 are net48-only COM interop assemblies: never compiled into the net8.0 flavor. -->
    <Compile Remove="Dte\**\*.cs" />
  </ItemGroup>

</Project>
