<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The web layer's CPS exports (docs/WEB.md, "F5"): KubunoWebDebugLaunchProvider, the debugger of a Kubuno core or
    module .rsproj (Kubuno.Web.Sdk sets DebuggerFlavor=KubunoWebDebugger). Compiled against the running Visual Studio's
    own CPS and shell assemblies, like Kubuno.Rust.ProjectSystem; MEF component of the VSIX.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.Web.ProjectSystem</RootNamespace>
    <AssemblyName>Kubuno.Web.ProjectSystem</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <KubunoVsInstallDir Condition="'$(KubunoVsInstallDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)\..\..\..'))\</KubunoVsInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.VisualStudio.ProjectSystem">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.ProjectSystem.VS">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.VS.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Interop">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Interop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.15.0">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Framework">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="envdte">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\envdte.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="envdte80">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\envdte80.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Build.Framework">
      <HintPath>$(KubunoVsInstallDir)MSBuild\Current\Bin\Microsoft.Build.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Collections.Immutable">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\System.Collections.Immutable.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Threading">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kubuno.Web.Logic\Kubuno.Web.Logic.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.Launch\Kubuno.Rust.Launch.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.ProjectSystem\Kubuno.Rust.ProjectSystem.csproj" />
    <ProjectReference Include="..\..\Shared\Kubuno.Shared\Kubuno.Shared.csproj" />
  </ItemGroup>

</Project>
