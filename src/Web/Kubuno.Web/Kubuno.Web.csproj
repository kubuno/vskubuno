<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Web layer (docs/ARCHITECTURE.md, "Layers (as built)" and "Roadmap - Kubuno web modules in the same VSIX"): the
    Visual Studio side of the Kubuno CORE and WEB MODULES (docs/WEB.md): the Tools commands (web solution generation,
    version tools, .kbpkg packaging) and the "Kubuno Web Module" template. F5 is Kubuno.Web.ProjectSystem's, the build
    Kubuno.Web.Sdk's, the shared logic Kubuno.Web.Logic's.

    References Kubuno.Shared and the Rust layer only - never Kubuno.Desktop or Kubuno.Mobile (enforced by
    tests/Kubuno.Architecture.Tests): a web module reuses the Rust support (rust-analyzer, Cargo, .rsproj,
    debugging) untouched.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.Web</RootNamespace>
    <AssemblyName>Kubuno.Web</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as every other Visual Studio assembly of the extension (bump them together). -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="EnvDTE" Version="17.14.40260" ExcludeAssets="runtime" />
  </ItemGroup>

  <PropertyGroup>
    <!-- $(VsInstallRoot) is only defined by Microsoft.VsSDK.targets (VSIX projects): the Visual Studio running MSBuild. -->
    <VsInstallRoot Condition="'$(VsInstallRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)\..\..\..'))</VsInstallRoot>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WebView2 (docs/WEB-VIEWS.md, WV-9a spike): Visual Studio's OWN copy, compiled against and never shipped
      (Private=False). devenv.exe.config redirects Microsoft.Web.WebView2.Core/Wpf 0.0.0.0-<its version> to the copy in
      PrivateAssemblies, so building against that same file can neither bind to a second copy nor use an API newer than
      the one loaded at run time (1.0.3967.48 in Visual Studio 18.0). Its WebView2Loader.dll sits next to it.
    -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.Web.WebView2.Wpf.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The spike surface's test page, served from the assembly (no network, nothing extra in the VSIX). -->
    <EmbeddedResource Include="WebDesigner\Spike\Assets\**\*.*" LogicalName="WebSurfaceSpike/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Kubuno.Shared\Kubuno.Shared.csproj" />
    <ProjectReference Include="..\..\Shared\Kubuno.Shared.Logic\Kubuno.Shared.Logic.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust\Kubuno.Rust.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.Logic\Kubuno.Rust.Logic.csproj" />
    <!--
      docs/WEB-VIEWS.md WV-8: the view designer shared with the desktop target (Toolbox, Properties, events, pickers, the
      design-surface protocol and the IProtocolDesignSurfaceHost seam the WebView2 surface of WV-9b implements). Never
      Kubuno.Desktop (enforced by tests/Kubuno.Architecture.Tests).
    -->
    <ProjectReference Include="..\..\Views\Kubuno.Views\Kubuno.Views.csproj" />
    <ProjectReference Include="..\..\Views\Kubuno.Views.Logic\Kubuno.Views.Logic.csproj" />
    <ProjectReference Include="..\Kubuno.Web.Logic\Kubuno.Web.Logic.csproj" />
    <!-- Preloaded by WebLayer so the template engine's Assembly.Load finds it (like the Rust and Desktop wizards). -->
    <ProjectReference Include="..\Kubuno.Web.TemplateWizard\Kubuno.Web.TemplateWizard.csproj" />
  </ItemGroup>

</Project>
