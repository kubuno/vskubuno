<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Web layer (docs/ARCHITECTURE.md, "Layers (as built)" and "Roadmap - Kubuno web modules in the same VSIX"): the
    Visual Studio side of the Kubuno CORE and WEB MODULES (docs/WEB.md): the Tools commands (web solution generation,
    version tools, .kbpkg packaging) and the "Kubuno Web Module" template. F5 is Kubuno.Web.ProjectSystem's, the build
    Kubuno.Web.Sdk's, the shared logic Kubuno.Web.Logic's.

    References Kubuno.Core and the Rust layer only - never Kubuno.Desktop or Kubuno.Mobile (enforced by
    tests/Kubuno.Architecture.Tests): a web module reuses the Rust support (rust-analyzer, Cargo, .rsproj,
    debugging) untouched.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.Web</RootNamespace>
    <AssemblyName>Kubuno.Web</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as every other Visual Studio assembly of the extension (bump them together). -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="EnvDTE" Version="17.14.40260" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Kubuno.Core\Kubuno.Core.csproj" />
    <ProjectReference Include="..\..\Core\Kubuno.Core.Logic\Kubuno.Core.Logic.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust\Kubuno.Rust.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.Logic\Kubuno.Rust.Logic.csproj" />
    <ProjectReference Include="..\Kubuno.Web.Logic\Kubuno.Web.Logic.csproj" />
    <!-- Preloaded by WebLayer so the template engine's Assembly.Load finds it (like the Rust and Desktop wizards). -->
    <ProjectReference Include="..\Kubuno.Web.TemplateWizard\Kubuno.Web.TemplateWizard.csproj" />
  </ItemGroup>

</Project>
