      </Group>
      <!-- docs/DATA.md DATA-7: the project node's "Database" submenu and the Migrations node's context menu. -->
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDatabaseProjectGroup" priority="0x0350">
