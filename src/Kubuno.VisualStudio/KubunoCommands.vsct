  <VisibilityConstraints>
    <!--
      Per-button (not per-group): IDG_VS_CTXT_PROJECT_ADD_REFERENCES/_FORMS/_MISC are shell-owned
      groups shared with every other project type (WinForms/C# inject their own items into the same
      groups) - hiding the GROUP would hide those other systems' commands too. Each of ours is
      individually hidden unless the active project is a .rsproj.
    -->
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddProjectReference" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddKubunoView" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustModule" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustIntegrationTest" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustExample" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustBinary" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddKubunoCustomControl" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddKubunoUserControl" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddKubunoInheritedControl" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddKubunoComponent" context="guidRustProjectUIContext" />
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddCargoDependency" context="guidRustProjectUIContext" />
    <!-- docs/DATA.md DATA-7: the project node's "Database" submenu, .rsproj only. -->
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="KubunoDatabaseProjectMenu" context="guidRustProjectUIContext" />
    <!-- The designer Layout toolbar (docs/DESIGNER.md Â§13): shown while a .kbview designer is the active document. -->
    <VisibilityItem guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" context="guidKubunoDesignerCmdUI" />
  </VisibilityConstraints>
  <!--
    docs/DATA.md DATA-5: in a query window (its own key binding scope, ProvideKeyBindingTable on KubunoPackage), F5 and
    Ctrl+Shift+E execute and Alt+Break cancels, like SQL Server's query editor.
  -->
  <KeyBindings>
    <KeyBinding guid="guidKubunoCommandsPackageCmdSet" id="cmdidQueryExecute" editor="guidKubunoQueryWindow" key1="E" mod1="Control Shift" />
    <KeyBinding guid="guidKubunoCommandsPackageCmdSet" id="cmdidQueryExecute" editor="guidKubunoQueryWindow" key1="VK_F5" />
    <KeyBinding guid="guidKubunoCommandsPackageCmdSet" id="cmdidQueryCancel" editor="guidKubunoQueryWindow" key1="VK_CANCEL" mod1="Alt" />
    <!-- docs/DATA.md DATA-6: View > Other Windows > Data Sources, Visual Studio's own chord for its Data Sources window. -->
    <KeyBinding guid="guidKubunoCommandsPackageCmdSet" id="cmdidShowDataSources" editor="guidVSStd97" key1="D" mod1="Alt Shift" />
  </KeyBindings>


</CommandTable>
