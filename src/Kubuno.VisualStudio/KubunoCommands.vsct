<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!--
    Phase 1c: "Kubuno: Debug Rust Test at Cursor" (Debugging\DebugRustTestAtCursorCommand.cs).
    Placed in the Tools menu, a fixed, low-risk location that avoids depending on undocumented
    dynamic-visibility wiring for the .rs editor's own context menu - see the phase 1c report for
    the fuller reasoning (same "prefer the documented route" principle as launch.vs.json over
    ILaunchDebugTargetProvider). Its BeforeQueryStatus handler already enables/disables it based
    on the active document being a .rs file.
  -->

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>

  <Commands package="guidKubunoPackage">
    <Menus>
      <!--
        Floating context menu shown programmatically (IVsUIShell.ShowContextMenu) by
        DependenciesTreeItem/DependencyTreeItem's IContextMenuPattern - never reached from any shell
        menu, so its Parent/Priority never matter for placement (SolutionExplorer\DependenciesNodeContextMenu.cs).
      -->
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeContextMenu" priority="0x0000" type="Context">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoItemContextMenuGroup"/>
        <Strings>
          <ButtonText>Kubuno Dependencies</ButtonText>
        </Strings>
      </Menu>
      <!-- One dependency node's floating context menu (DependencyTreeItem, same mechanism). -->
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemContextMenu" priority="0x0000" type="Context">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoItemContextMenuGroup"/>
        <Strings>
          <ButtonText>Kubuno Dependency</ButtonText>
        </Strings>
      </Menu>

      <!--
        The .kbview design surface's context menus (docs/DESIGNER.md §12), shown by
        DesignSurfaceEditingCoordinator.Commands.cs through IVsUIShell.ShowContextMenu with a
        DesignerContextMenuCommandTarget (Kubuno.VisualStudio.Designer), which answers every item's
        state and - for our own commands (TextChanges) - its text in VS's UI language; the English
        texts below are the fallback. Ids MUST match DesignerCommandIds. Cut/Copy/Paste/Delete, View
        Code and Bring to Front/Send to Back are VS's own standard commands (CommandPlacements below),
        so they show VS's own localized text and shortcut, like in the Windows Forms designer.
      -->
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" priority="0x0000" type="Context">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoItemContextMenuGroup"/>
        <Strings>
          <ButtonText>Kubuno Designer Element</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerViewContextMenu" priority="0x0000" type="Context">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoItemContextMenuGroup"/>
        <Strings>
          <ButtonText>Kubuno Designer View</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerCreateHandlerMenu" priority="0x0100" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerHandlerGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Create Handler</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSelectMenu" priority="0x0100" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSelectGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Select</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerWrapMenu" priority="0x0100" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerWrapGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Wrap In</ButtonText>
        </Strings>
      </Menu>

      <!--
        docs/DESIGNER.md §13: the Windows Forms designer's Layout commands. Every item is one of VS's own
        standard commands (guidVSStd97: Align Lefts..., Make Same Size, spacing, Center, z-order - with VS's
        own icons and localized names), placed below in the element context menu's Layout submenus and in the
        designer's Layout toolbar, and answered by DesignerWindowPane / DesignerContextMenuCommandTarget from
        the current selection. The toolbar shows while a .kbview designer is the active document (its command
        UI context, KbviewEditorFactory's pguidCmdUI, VisibilityConstraints below).
      -->
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerAlignMenu" priority="0x0100" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Align</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSizeMenu" priority="0x0101" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Make Same Size</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerHorizontalSpacingMenu" priority="0x0102" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Horizontal Spacing</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerVerticalSpacingMenu" priority="0x0103" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Vertical Spacing</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerCenterMenu" priority="0x0104" type="Menu">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Center in View</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" priority="0x0000" type="Toolbar">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar"/>
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>Kubuno Layout</ButtonText>
          <CommandName>Kubuno Layout</CommandName>
        </Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
      <!--
        docs/RSPROJ.md work package 5: "Generate Visual Studio Projects" on the item-node context
        menu - IDM_VS_CTXT_ITEMNODE is the standard "selected file" context menu, shared by
        classic Solution Explorer project items and Open Folder's synthetic file nodes alike.
        DynamicVisibility (see GenerateRustProjectsCommand.OnContextBeforeQueryStatus) hides it
        unless the selection is a single workspace-root Cargo.toml.
      -->
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoItemContextMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE"/>
      </Group>

      <!--
        The Dependencies node's own floating context menu group (KubunoDependenciesNodeContextMenu
        above, shown via IVsUIShell.ShowContextMenu - SolutionExplorer\DependenciesNodeContextMenu.cs).
      -->
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeContextMenuGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeUpdateGroup" priority="0x0200">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeScopeGroup" priority="0x0300">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeContextMenu" />
      </Group>
      <!-- One dependency's menu, in the .NET project system's order: open, update/remove, paths, scope, properties. -->
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemOpenGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemEditGroup" priority="0x0200">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemPathGroup" priority="0x0300">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemScopeGroup" priority="0x0400">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemPropertiesGroup" priority="0x0500">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemContextMenu" />
      </Group>

      <!-- The .kbview design surface's element menu, in WinForms order. -->
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerCodeGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerHandlerGroup" priority="0x0200">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerClipboardGroup" priority="0x0300">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSelectGroup" priority="0x0400">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerOrderGroup" priority="0x0500">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerWrapGroup" priority="0x0600">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerPropertiesGroup" priority="0x0700">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerHandlerListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerCreateHandlerMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSelectListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSelectMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerWrapListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerWrapMenu" />
      </Group>

      <!-- The view menu (canvas background, frame title bar). -->
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerViewPasteGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerViewContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerViewCodeGroup" priority="0x0200">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerViewContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerViewPropertiesGroup" priority="0x0300">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerViewContextMenu" />
      </Group>
      <!-- docs/DESIGNER.md §13: the Layout submenus of the element context menu, and the Layout toolbar groups. -->
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutGroup" priority="0x0450">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerElementContextMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerAlignListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerAlignMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSizeListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerSizeMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerHorizontalSpacingListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerHorizontalSpacingMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerVerticalSpacingListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerVerticalSpacingMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerCenterListGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerCenterMenu" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerToolbarAlignGroup" priority="0x0100">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerToolbarSizeGroup" priority="0x0200">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerToolbarHorizontalSpacingGroup" priority="0x0300">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerToolbarVerticalSpacingGroup" priority="0x0400">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerToolbarCenterGroup" priority="0x0500">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" />
      </Group>
      <Group guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerToolbarOrderGroup" priority="0x0600">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDesignerLayoutToolbar" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDebugRustTestAtCursor" priority="0x0100" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Test" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Kubuno: Debug Rust Test at Cursor</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidShowKubunoOutline" priority="0x0102" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Kubuno View Outline</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidGenerateRustProjects" priority="0x0103" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="OpenProjectFolder" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Kubuno: Generate Visual Studio Projects</ButtonText>
        </Strings>
      </Button>
      <!-- Recovery tool: restarts the Rust language server (RestartRustAnalyzerCommand; French text set at run time). -->
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidRestartRustAnalyzer" priority="0x0104" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoToolsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Restart" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Kubuno: Restart rust-analyzer</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidGenerateRustProjectsContext" priority="0x0100" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoItemContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="OpenProjectFolder" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Kubuno: Generate Visual Studio Projects</ButtonText>
        </Strings>
      </Button>

      <!--
        Extended "Ajouter" CASCADING SUBMENU on a .rsproj project node (not the top-level project
        context menu - the earlier revision of this file got that wrong, verified live: it rendered
        these as flat top-level entries instead of nested under "Ajouter ›"). The real "Ajouter"
        flyout is not a distinct shell-defined Menu id third parties can see in vsshlids.h - it is
        assembled by the shell from a handful of well-known GROUPS inside IDM_VS_CTXT_PROJNODE, the
        same ones the WinForms/C# project system itself injects "Référence...", "Formulaire (Windows
        Forms)...", "Contrôle utilisateur...", "Composant...", "Classe..." into - so third-party
        commands join that same flyout by using THOSE groups as their own Parent directly, not by
        defining a competing Menu. Scoped to .rsproj only via per-Button VisibilityConstraints
        (guidRustProjectUIContext, a ProvideUIContextRule on ActiveProjectCapability:RustProjectSystem
        - see KubunoPackage.cs) since these groups are shared with every other project type.
      -->
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddProjectReference" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_REFERENCES" />
        <Icon guid="ImageCatalogGuid" id="Reference" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Référence de projet...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddKubunoView" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_FORMS" />
        <Icon guid="guidRustProjectImages" id="RustFile" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Vue Kubuno...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustModule" priority="0x0101" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_FORMS" />
        <Icon guid="guidRustProjectImages" id="RustFile" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Module Rust...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustIntegrationTest" priority="0x0102" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_FORMS" />
        <Icon guid="ImageCatalogGuid" id="Test" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Test d'intégration...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustExample" priority="0x0103" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_FORMS" />
        <Icon guid="guidRustProjectImages" id="RustFile" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Exemple...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddRustBinary" priority="0x0104" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_FORMS" />
        <Icon guid="guidRustProjectImages" id="RustFile" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Binaire...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidAddCargoDependency" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_ADD_MISC" />
        <Icon guid="guidRustProjectImages" id="CargoManifest" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Dépendance Cargo (crate)...</ButtonText>
        </Strings>
      </Button>

      <!--
        The Dependencies node's and a dependency node's own context menus (IContextMenuPattern on
        the tree items, SolutionExplorer/TreeItems.cs), shown via IVsUIShell.ShowContextMenu with
        DependenciesNodeCommandTarget, which answers every command's state and - TextChanges - its
        text in VS's UI language (the English texts here are the fallback). Not parented under any
        shell menu, so no VisibilityConstraints are needed.
      -->
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDependenciesAddProjectReference" priority="0x0100" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Reference" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Add Project Reference...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDependenciesManageCrates" priority="0x0101" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="PackageReference" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Manage Crates...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDependenciesUpdateAll" priority="0x0100" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeUpdateGroup" />
        <Icon guid="ImageCatalogGuid" id="RunUpdate" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Update Crates</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDependenciesRemoveUnused" priority="0x0101" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependenciesNodeUpdateGroup" />
        <Icon guid="ImageCatalogGuid" id="CleanData" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Remove Unused Dependencies...</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDependencyOpenDocumentation" priority="0x0100" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemOpenGroup" />
        <Icon guid="ImageCatalogGuid" id="OpenWebSite" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Open Documentation</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDependencyOpenSource" priority="0x0101" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemOpenGroup" />
        <Icon guid="ImageCatalogGuid" id="GoToSourceCode" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Open Source Code</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKubunoCommandsPackageCmdSet" id="cmdidDependencyManage" priority="0x0100" type="Button">
        <Parent guid="guidKubunoCommandsPackageCmdSet" id="KubunoDependencyItemEditGroup" />
        <Icon guid="ImageCatalogGuid" id="PackageReference" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Manage Crates...</ButtonText>
