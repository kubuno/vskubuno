<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
  xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
  xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="Kubuno.VisualStudio.a3f0e6c2-5b1d-4e6a-8b1a-9c1a2f3e4d5c" Version="1.0.0" Language="en-US" Publisher="Kubuno" />
        <DisplayName>Kubuno for Visual Studio</DisplayName>
        <Description xml:space="preserve">Rust language support (rust-analyzer, syntax coloring, rustfmt) for developing Kubuno modules in Visual Studio.</Description>
        <MoreInfo>https://github.com/kubuno/vskubuno</MoreInfo>
        <ReleaseNotes>https://github.com/kubuno/vskubuno/blob/main/CHANGELOG.md</ReleaseNotes>
        <Tags>Rust;Cargo;rust-analyzer;Kubuno</Tags>
    </Metadata>
    <Installation>
        <!--
          [17.0,) rather than [18.0,): VS 2026's compatibility model only checks the lower bound
          (upper bound is ignored), so this open range covers 18.x (VS 2026) while also staying
          installable on 17.x (VS 2022) - the range the default VSIX template itself now generates.
          amd64 is the only architecture actually verified (see README); arm64 is declared because
          this is a pure .NET Framework/managed extension with no native P/Invoke beyond spawning
          rust-analyzer, so nothing here is expected to be architecture-specific, but it has not
          been run on an arm64 Visual Studio.
        -->
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
            <ProductArchitecture>arm64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0,)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0,)">
            <ProductArchitecture>arm64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,)">
            <ProductArchitecture>arm64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
        <!--
          One MefComponent asset per assembly that exports MEF parts (docs/ARCHITECTURE.md, "Layers (as built)"):
          Visual Studio only composes the assemblies a manifest names - composition from %CurrentProject% alone was
          live-verified NOT sufficient for kubuno-views-ls.exe to start for a .kbview file when its language client
          lived in another assembly. Shared exports nothing today; the Web and Mobile layers are listed already so their
          first MEF part needs no manifest change.
        -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Shared" Path="|Kubuno.Shared|" />
        <!-- Rust layer: rust-analyzer, IntelliSense, Cargo workspaces... -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Rust" Path="|Kubuno.Rust|" />
        <!-- docs/RSPROJ.md work package 3: CPS exports of the .rsproj project type (the counterpart of
             Microsoft.VisualStudio.JavaScript.ProjectSystem.dll's own MefComponent asset). -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Rust.ProjectSystem" Path="|Kubuno.Rust.ProjectSystem|" />
        <!-- Views layer: the .kbview language client and content type, F12 on a resource name in Rust... -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Views" Path="|Kubuno.Views|" />
        <!-- Desktop layer: .kbview IntelliSense in Rust files, SQL in Rust strings, override members... -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Desktop" Path="|Kubuno.Desktop|" />
        <!-- The desktop target's CPS exports in a .rsproj (the .kbview default editor and icon). -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Desktop.ProjectSystem" Path="|Kubuno.Desktop.ProjectSystem|" />
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Web" Path="|Kubuno.Web|" />
        <!-- docs/WEB.md: the web target's CPS exports (F5 of a Kubuno core or module .rsproj, KubunoWebDebugLaunchProvider). -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Web.ProjectSystem" Path="|Kubuno.Web.ProjectSystem|" />
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Mobile" Path="|Kubuno.Mobile|" />
        <!--
          Kubuno.Rust.TestAdapter's own INTEGRATION.md #3.2: two registrations for the SAME assembly
          (Kubuno.Rust.TestAdapter.dll, copied into this VSIX's output by the ProjectReference in
          Kubuno.VisualStudio.csproj) - MefComponent registers KubunoTestContainerDiscoverer
          ([Export(typeof(ITestContainerDiscoverer))], what makes Test Explorer know Cargo.toml
          files exist); UnitTestExtension registers KubunoTestDiscoverer/KubunoTestExecutor with
          VSTest's extension manager (what makes a run/debug actually work), matching the real,
          currently-shipping "CMake Linux and Mac Test Adapter" extension's own manifest shape.
        -->
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="Kubuno.Rust.TestAdapter" Path="|Kubuno.Rust.TestAdapter|" />
        <Asset Type="UnitTestExtension" d:Source="Project" d:ProjectName="Kubuno.Rust.TestAdapter" Path="|Kubuno.Rust.TestAdapter|" />
        <!--
          docs/RSPROJ.md Addendum (lot 7): "Create a new project"/"Add New Item" templates. Path is
          relative to this manifest's own folder (d:Source defaults to "File" - unlike the
          Project-sourced assets above); the VSSDK build zips each immediate subfolder containing a
          .vstemplate into its own .zip under ProjectTemplates\/ItemTemplates\ in the built VSIX, the
          same mechanism the stock "VSIX Project" C#/VB project template scaffolding uses.
        -->
        <!--
          docs/DEBUGGING.md: Kubuno.natvis, registered for every native debug session wherever the VSIX is installed
          (Microsoft Learn, "Create custom views of C++ objects", "install and register a .natvis file via a VSIX
          package"), and the Concord component that gives a Rust panic its message in the exception helper.
        -->
        <Asset Type="NativeVisualizer" Path="Debugging\Visualizers\Kubuno.natvis" />
        <Asset Type="DebuggerEngineExtension" Path="Kubuno.Rust.Debugger.vsdconfig" />
        <Asset Type="Microsoft.VisualStudio.ProjectTemplate" Path="ProjectTemplates" />
        <Asset Type="Microsoft.VisualStudio.ItemTemplate" Path="ItemTemplates" />
    </Assets>
</PackageManifest>
