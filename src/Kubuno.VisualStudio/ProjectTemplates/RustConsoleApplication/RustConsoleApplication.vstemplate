<?xml version="1.0" encoding="utf-8"?>
<!--
  docs/RSPROJ.md Addendum (lot 7): "Rust console application" - a .rsproj + Cargo.toml + src/main.rs,
  reusing Kubuno.Rust.Sdk (work packages 1-3) exactly like a hand-written or "Generate Visual Studio
  Projects"-produced .rsproj (docs/RSPROJ.md §4). LanguageTag/PlatformTag/ProjectTypeTag are the
  custom "Create a new project" dialog filter values the product owner asked for.
-->
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Rust Console Application</Name>
    <Description>A command-line Rust application, built and debugged through Cargo as a real MSBuild/CPS project (.rsproj) - not an Open Folder workspace.</Description>
    <ProjectType>Rust</ProjectType>
    <TemplateID>Kubuno.Rust.RustConsoleApplication</TemplateID>
    <LanguageTag>Rust</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Console</ProjectTypeTag>
    <Icon>__TemplateIcon.png</Icon>
    <ProjectSubType>
    </ProjectSubType>
    <SortOrder>10</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>RustConsoleApp</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <CreateInPlace>true</CreateInPlace>
    <SupportsMasterPage>false</SupportsMasterPage>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.rsproj" File="ProjectTemplate.rsproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="Cargo.toml">Cargo.toml</ProjectItem>
      <Folder Name="src" TargetFolderName="src">
        <ProjectItem ReplaceParameters="true" TargetFileName="main.rs">main.rs</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
  <!--
    docs/RSPROJ.md Addendum (lot 7), "Crate-name casing, revisited": Kubuno.VisualStudio.TemplateWizard
    (a SEPARATE assembly from Kubuno.VisualStudio.dll - see its own csproj header) adds $cratename$
    (a Cargo-valid package name derived from $safeprojectname$: lower-cased, invalid characters
    turned into '-', guaranteed to start with a letter) and $moduleid$ ($cratename$ with '-' -> '_')
    to the replacements dictionary before Cargo.toml/the .rsproj below are expanded. The FIRST attempt
    at this self-registered Kubuno.VisualStudio.dll's own codeBase and broke KubunoPackage's load;
    this assembly's registration (KubunoPackage.cs) is not self-referential, so it does not.
  -->
  <WizardExtension>
    <Assembly>Kubuno.VisualStudio.TemplateWizard, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>Kubuno.VisualStudio.TemplateWizard.CrateNameWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
