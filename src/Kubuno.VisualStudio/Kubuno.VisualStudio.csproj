    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <!--
      Combining several first-party Microsoft.VisualStudio.* NuGet packages of slightly different
      vintages (Microsoft.VisualStudio.SDK 17.14.x pulling 18.x-era transitive VS assemblies vs.
      Microsoft.VisualStudio.Workspace.VSIntegration 17.12.19 and the VS-install-only
      TestWindow/EnvDTE assemblies Kubuno.TestAdapter/Kubuno.Mcp.Bridge resolve against) makes
      MSBuild's reference unification report an MSB3277 "unresolved conflict" note for each one it
      auto-resolves (always by picking the highest version - the same resolution the running VS
      instance itself performs at load time). This is expected/benign for a VSSDK extension
      referencing this many VS SDK packages at once, not a real version mismatch to fix by hand;
      suppressed here rather than silenced per-conflict, which would need re-editing on every SDK
      package bump.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
