  <PropertyGroup>
    <!--
      kubuno-views-ls.exe (Rust LSP server, Kubuno.VisualStudio.Views' INTEGRATION.md #6) - built
      out-of-band from the separate `desktop` repo
      (Z:\projects\kubuno\desktop\windows, crate kubuno-views-ls):
        cd Z:\projects\kubuno\desktop\windows
        $env:CARGO_TARGET_DIR = "C:\kubuno-build\desktop-target"   # this workspace's documented default (vskubuno/CLAUDE.md #5)
        cargo build -p kubuno-views-ls -r        (-r is cargo's short form of the "release" flag)
      Default matches that convention; override with /p:KubunoViewsLsExePath=<path> for a
      differently-configured CARGO_TARGET_DIR, or in CI (see .github/workflows/build.yml, which
      checks out kubuno/desktop and builds this crate before invoking MSBuild).
    -->
    <KubunoViewsLsExePath Condition="'$(KubunoViewsLsExePath)' == ''">C:\kubuno-build\desktop-target\release\kubuno-views-ls.exe</KubunoViewsLsExePath>
    <!--
      kubuno-vs-mcp.exe (Kubuno.Mcp, net8.0 - docs/MCP.md "Integration"). Default: this repo's own
      build output for the same $(Configuration) (a ReferenceOutputAssembly=false ProjectReference
      below drives that build as part of this solution/project build - see its own comment for why
      it is not a normal assembly reference). Override with /p:KubunoMcpOutputDir=<path> to ship a
      self-contained `dotnet publish` output instead.
    -->
    <KubunoMcpOutputDir Condition="'$(KubunoMcpOutputDir)' == ''">$(MSBuildThisFileDirectory)..\Kubuno.Mcp\bin\$(Configuration)\net8.0\</KubunoMcpOutputDir>
  </PropertyGroup>

  <Target Name="KubunoCheckToolExes" BeforeTargets="Build">
    <Error Condition="!Exists('$(KubunoViewsLsExePath)')"
           Text="kubuno-views-ls.exe not found at '$(KubunoViewsLsExePath)'. Build it from the desktop repo: cd Z:\projects\kubuno\desktop\windows ; $env:CARGO_TARGET_DIR='C:\kubuno-build\desktop-target' ; cargo build --release -p kubuno-views-ls -- or pass /p:KubunoViewsLsExePath=&lt;path to kubuno-views-ls.exe&gt;." />
    <Error Condition="!Exists('$(KubunoMcpOutputDir)kubuno-vs-mcp.exe')"
           Text="kubuno-vs-mcp.exe not found under '$(KubunoMcpOutputDir)'. It should have been built automatically as part of this solution (src\Kubuno.Mcp\Kubuno.Mcp.csproj) - build that project first, or pass /p:KubunoMcpOutputDir=&lt;its output folder&gt;." />
  </Target>

  <ItemGroup>
    <Content Include="$(KubunoViewsLsExePath)">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\kubuno-views-ls.exe</Link>
    </Content>
    <!--
      Every file Kubuno.Mcp's own build produces (kubuno-vs-mcp.exe/.dll/.deps.json/.runtimeconfig.json
      and its dependency DLLs, e.g. ModelContextProtocol*.dll) - it is a framework-dependent net8.0
      exe, not self-contained, so all of these are required for it to actually run once shipped.
    -->
    <Content Include="$(KubunoMcpOutputDir)**\*.*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\kubuno-vs-mcp\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!--
      Kubuno.Cargo (netstandard2.0) depends on System.Text.Json 8.0.5, which - unlike
      Newtonsoft.Json - .NET Framework 4.8 does not ship, plus its own netstandard2.0 polyfill
      closure. These resolve and copy-local correctly into bin\Debug (proving the reference
      itself is fine), but - unlike a project's own direct <Reference>/<ProjectReference> output -
      VSSDK's VSIX-packaging step was verified (by inspecting the built .vsix's zip contents) to
      silently drop them when only pulled in transitively; a <Target> computing them from
      @(ReferenceCopyLocalPaths) after ResolveReferences was tried and confirmed present in that
      item group, but still ran too late for whatever earlier target VSSDK uses to decide VSIX
      membership. Explicit, statically-declared Content items (the same mechanism already used
      for languages.pkgdef/the grammar files above) are what actually works. $(NuGetPackageRoot)
      is set by the auto-imported *.nuget.g.props before this ItemGroup is evaluated, so no
      absolute machine path is hard-coded - only the package versions are (System.Text.Json's own
      pin above, and its dependencies' versions as resolved into obj\project.assets.json; bump
      these together if System.Text.Json's version ever changes).
    -->
    <Content Include="$(NuGetPackageRoot)system.text.json\8.0.5\lib\net462\System.Text.Json.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.Text.Json.dll</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)system.buffers\4.6.0\lib\net462\System.Buffers.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.Buffers.dll</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)system.memory\4.6.0\lib\net462\System.Memory.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.Memory.dll</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)system.numerics.vectors\4.6.0\lib\net462\System.Numerics.Vectors.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.Numerics.Vectors.dll</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)system.runtime.compilerservices.unsafe\6.1.0\lib\net462\System.Runtime.CompilerServices.Unsafe.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.Runtime.CompilerServices.Unsafe.dll</Link>
    </Content>
    <!--
      Added after a live Test Explorer smoke test: discovery (Kubuno.TestAdapter.dll, loaded by
      VSTest's UnitTestExtension host, not the in-proc VSSDK AppDomain the six DLLs above were
      first added for - see Kubuno.TestAdapter/AssemblyResolution.cs for why that host needs its
      *own* fix too) failed with the exact same "file not found" pattern this whole ItemGroup
      exists to prevent, this time for Microsoft.Bcl.AsyncInterfaces (IAsyncEnumerable support -
      needed once Kubuno.Cargo's JSON parsing/CargoWorkspaceSource's IWorkspace4.GetFilesAsync are
      actually exercised, not just referenced).
    -->
    <Content Include="$(NuGetPackageRoot)microsoft.bcl.asyncinterfaces\9.0.0\lib\net462\Microsoft.Bcl.AsyncInterfaces.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Microsoft.Bcl.AsyncInterfaces.dll</Link>
    </Content>
    <!-- Also part of Kubuno.TestAdapter's own dependency closure (confirmed via its plain `dotnet build` output, which does copy every transitive dependency correctly - only VSIX packaging drops them, per this ItemGroup's opening comment). -->
    <Content Include="$(NuGetPackageRoot)system.valuetuple\4.5.0\lib\net47\System.ValueTuple.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.ValueTuple.dll</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)system.threading.tasks.extensions\4.6.0\lib\net462\System.Threading.Tasks.Extensions.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>System.Threading.Tasks.Extensions.dll</Link>
    </Content>
  </ItemGroup>
