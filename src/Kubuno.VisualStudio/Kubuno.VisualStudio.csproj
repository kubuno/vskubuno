      <Link>Grammars\Kbview\THIRD-PARTY-NOTICES.md</Link>
    </Content>
    <!--
      docs/RSPROJ.md Addendum (lot 7): "Create a new project"/"Add New Item" templates. Unlike the
      "Path"-only Asset entries a stock VSIX Project Template item adds by default, this VSSDK
      version's packaging step (Microsoft.VsSDK.targets' CollectVSIXItems) only picks up files it
      already knows about as project items - the two ProjectTemplate/ItemTemplate Asset entries in
      source.extension.vsixmanifest do nothing on their own without these explicit, wildcarded
      Content items (verified live: omitting them produced a .vsix with no template files at all).
      %(RecursiveDir) preserves each template's own subfolder under ProjectTemplates/ItemTemplates.
    -->
    <Content Include="ProjectTemplates\**\*.*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ProjectTemplates\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="ItemTemplates\**\*.*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ItemTemplates\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <!--
      kubuno-views-ls.exe (Rust LSP server, Kubuno.VisualStudio.Views' INTEGRATION.md #6) - built
      out-of-band from the separate `desktop` repo
      (Z:\src\desktop\windows, crate kubuno-views-ls):
        cd Z:\src\desktop\windows
        $env:CARGO_TARGET_DIR = "C:\kubuno-build\desktop-target"   # this workspace's documented default (vskubuno/CLAUDE.md #5)
        cargo build -p kubuno-views-ls -r        (-r is cargo's short form of the "release" flag)
      Default matches that convention; override with /p:KubunoViewsLsExePath=<path> for a
      differently-configured CARGO_TARGET_DIR, or in CI (see .github/workflows/build.yml, which
      checks out kubuno/desktop and builds this crate before invoking MSBuild).
    -->
    <KubunoViewsLsExePath Condition="'$(KubunoViewsLsExePath)' == ''">C:\kubuno-build\desktop-target\release\kubuno-views-ls.exe</KubunoViewsLsExePath>
    <!--
      kubuno-views-ls.exe is NOT self-contained: the desktop workspace links kubuno-ui as a Rust
      dylib with -C prefer-dynamic (desktop/windows/.cargo/config.toml), so the exe imports
      kubuno_ui.dll and Rust's own std-<hash>.dll. Shipped alone it dies at load time with
      STATUS_DLL_NOT_FOUND (0xC0000135) before reading a single byte of stdin, which VS reports as a
      JSON-RPC ConnectionLostException during "initialize". Both DLLs are therefore shipped beside it
      in tools\ (the Windows loader looks in the exe's own folder first):
        - kubuno_ui.dll comes from the SAME cargo build as the exe (Cargo uplifts it next to the exe);
          a Rust dylib has no stable ABI, so it must never be mixed with a different build.
        - std-*.dll comes from the toolchain that built the exe (default: the stable MSVC toolchain
          this workspace documents, vskubuno/CLAUDE.md #5); override with /p:KubunoRustStdDir=<dir>.
    -->
    <KubunoViewsLsDir>$([System.IO.Path]::GetDirectoryName('$(KubunoViewsLsExePath)'))\</KubunoViewsLsDir>
    <KubunoRustStdDir Condition="'$(KubunoRustStdDir)' == ''">$(USERPROFILE)\.rustup\toolchains\stable-x86_64-pc-windows-msvc\lib\rustlib\x86_64-pc-windows-msvc\lib\</KubunoRustStdDir>
    <!--
      kubuno-vs-mcp.exe (Kubuno.Mcp, net8.0 - docs/MCP.md "Integration"). Default: this repo's own
      build output for the same $(Configuration) (a ReferenceOutputAssembly=false ProjectReference
      below drives that build as part of this solution/project build - see its own comment for why
      it is not a normal assembly reference). Override with /p:KubunoMcpOutputDir=<path> to ship a
      self-contained `dotnet publish` output instead.
    -->
    <KubunoMcpOutputDir Condition="'$(KubunoMcpOutputDir)' == ''">$(MSBuildThisFileDirectory)..\Kubuno.Mcp\bin\$(Configuration)\net8.0\</KubunoMcpOutputDir>
    <!--
      kubuno-views-surface.exe (Kubuno.VisualStudio.Designer's own INTEGRATION.md §6, DSG-7's embedded
      design surface): built out-of-band from the desktop repo, same workspace as kubuno-views-ls but a
      SEPARATE CARGO_TARGET_DIR (this crate is still examples-only, see kubuno-views/examples/view_embed.rs -
      built on its own rather than sharing desktop-target's in-flight build):
        cd Z:\src\desktop\windows
        $env:CARGO_TARGET_DIR = "C:\kubuno-build\agent-dsgint"
        cargo build -r -p kubuno-views -j 1 (plus the cargo "example" flag, spelled with two dashes,
        naming view_embed - omitted above only because a doubled dash is not valid inside an XML
        comment; see src/Kubuno.VisualStudio.Designer/INTEGRATION.md §6 for the literal command)
      Shipped under its OWN tools\surface\ subfolder (see the Content items below), never merged with
      kubuno-views-ls.exe's own tools\kubuno_ui.dll/std-*.dll: a Rust dylib has no stable ABI, and this
      exe comes from a DIFFERENT CARGO_TARGET_DIR, so it needs its OWN matching kubuno_ui.dll copied
      alongside it, not kubuno-views-ls's.
    -->
    <KubunoViewsSurfaceExePath Condition="'$(KubunoViewsSurfaceExePath)' == ''">C:\kubuno-build\agent-dsgint\release\examples\view_embed.exe</KubunoViewsSurfaceExePath>
    <!--
      An example binary lands in <profile>\examples\ but Cargo still uplifts the workspace's own
      dylib (kubuno_ui.dll) one level up, at the profile root <profile>\ - the same layout
      kubuno-views-ls.exe's own KubunoViewsLsDir relies on for a non-example binary, just one
      directory higher here.
    -->
    <!--
      Independently settable rather than derived from KubunoViewsSurfaceExePath (matching
      KubunoRustStdDir's own precedent above): an example binary lands in <profile>\examples\, but
      Cargo still uplifts the workspace's own dylib (kubuno_ui.dll) one level up, at the profile root
      <profile>\ - override together if KubunoViewsSurfaceExePath is overridden to a differently
      shaped CARGO_TARGET_DIR.
    -->
    <KubunoViewsSurfaceProfileDir Condition="'$(KubunoViewsSurfaceProfileDir)' == ''">C:\kubuno-build\agent-dsgint\release\</KubunoViewsSurfaceProfileDir>
  </PropertyGroup>

  <Target Name="KubunoCheckSurfaceExe" BeforeTargets="Build">
    <Error Condition="!Exists('$(KubunoViewsSurfaceExePath)')"
           Text="kubuno-views-surface.exe (view_embed.exe) not found at '$(KubunoViewsSurfaceExePath)'. Build it: cd Z:\src\desktop\windows ; $env:CARGO_TARGET_DIR='C:\kubuno-build\agent-dsgint' ; cargo build --release --example view_embed -p kubuno-views -j 1 -- or pass /p:KubunoViewsSurfaceExePath=&lt;path&gt;." />
    <Error Condition="!Exists('$(KubunoViewsSurfaceProfileDir)kubuno_ui.dll')"
           Text="kubuno_ui.dll not found at '$(KubunoViewsSurfaceProfileDir)' (kubuno-views-surface.exe's own profile root). It must ship with the kubuno_ui.dll of the SAME cargo build (own CARGO_TARGET_DIR, do not reuse kubuno-views-ls's copy)." />
  </Target>

  <ItemGroup>
    <!--
      Link's directory (tools\surface\) is honored by VSIX packaging but its filename is NOT -
      verified live by inspecting the built .vsix's zip contents, the exe ships under its own source
      name regardless (see KubunoViewsSurfaceLocator.cs's own comment on this) - so this is left as
      view_embed.exe rather than renamed, matching what actually ships.
    -->
    <Content Include="$(KubunoViewsSurfaceExePath)">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\surface\view_embed.exe</Link>
    </Content>
    <Content Include="$(KubunoViewsSurfaceProfileDir)kubuno_ui.dll" Condition="Exists('$(KubunoViewsSurfaceProfileDir)kubuno_ui.dll')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\surface\kubuno_ui.dll</Link>
    </Content>
    <KubunoViewsSurfaceStdDll Include="$(KubunoRustStdDir)std-*.dll" />
    <Content Include="@(KubunoViewsSurfaceStdDll)">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\surface\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="KubunoCheckToolExes" BeforeTargets="Build">
    <Error Condition="!Exists('$(KubunoViewsLsExePath)')"
           Text="kubuno-views-ls.exe not found at '$(KubunoViewsLsExePath)'. Build it from the desktop repo: cd Z:\src\desktop\windows ; $env:CARGO_TARGET_DIR='C:\kubuno-build\desktop-target' ; cargo build --release -p kubuno-views-ls -- or pass /p:KubunoViewsLsExePath=&lt;path to kubuno-views-ls.exe&gt;." />
    <Error Condition="!Exists('$(KubunoViewsLsDir)kubuno_ui.dll')"
           Text="kubuno_ui.dll not found beside kubuno-views-ls.exe in '$(KubunoViewsLsDir)'. kubuno-views-ls.exe imports it (kubuno-ui is a Rust dylib) and must ship with the kubuno_ui.dll of the same cargo build." />
    <Error Condition="'@(KubunoRustStdDll)' == ''"
           Text="Rust's std-*.dll not found in '$(KubunoRustStdDir)'. kubuno-views-ls.exe imports it (-C prefer-dynamic); pass /p:KubunoRustStdDir=&lt;rustc --print sysroot&gt;\lib\rustlib\x86_64-pc-windows-msvc\lib\ for the toolchain that built it." />
  </Target>

  <ItemGroup>
    <Content Include="$(KubunoViewsLsExePath)">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\kubuno-views-ls.exe</Link>
    </Content>
    <!-- kubuno-views-ls.exe's runtime DLLs - see KubunoViewsLsDir/KubunoRustStdDir above. -->
    <KubunoRustStdDll Include="$(KubunoRustStdDir)std-*.dll" />
    <Content Include="$(KubunoViewsLsDir)kubuno_ui.dll" Condition="Exists('$(KubunoViewsLsDir)kubuno_ui.dll')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\kubuno_ui.dll</Link>
    </Content>
    <Content Include="@(KubunoRustStdDll)">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!--
    kubuno-vs-mcp.exe's own Content item CANNOT be a plain top-level <ItemGroup> glob like the ones
    above: those are fine because their source files (kubuno-views-ls.exe, view_embed.exe) are built
    OUTSIDE this solution, before this project is even opened, so they already exist on disk the
    moment MSBuild evaluates this file's items - which happens once, during the static EVALUATION
    pass, before any target (including this project's own ProjectReference-driven build of
    Kubuno.Mcp) executes. kubuno-vs-mcp.exe, by contrast, is built AS PART of this same solution
    build (the ReferenceOutputAssembly=false ProjectReference below) - on a clean checkout, nothing
    has built it yet at evaluation time, so a static `Content Include="$(KubunoMcpOutputDir)**\*.*"`
    silently matches ZERO files and the VSIX ships without the MCP bridge, with no error (found live:
    a full clean build produced a Kubuno.VisualStudio.vsix missing tools\kubuno-vs-mcp\ entirely,
    despite 0 build errors/warnings - KubunoCheckToolExes's own Error above never caught it either,
    since by the time THAT target ran - BeforeTargets="Build" - Kubuno.Mcp had, by then, already been
    built by ResolveProjectReferences, so the exists-check passed; only the item glob's own timing
    was wrong). Fixed by moving the glob into a target - AfterTargets="ResolveProjectReferences" ONLY,
    deliberately WITHOUT also pinning it BeforeTargets="Build": found live, by comparing MSBuild
    diagnostic-verbosity target IDs, that combining the two pins a target right before the outer
    "Build" target's own (near-empty) body, which for this VSSDK project only starts after its own
    huge DependsOn chain - including VSSDK's GetVsixSourceItems (the target that actually snapshots
    @(Content) with IncludeInVSIX=true for packaging) and CreateVsixContainer - has ALREADY run; a
    target pinned that way is always too late to contribute Content items, no matter how it is
    triggered. AfterTargets alone inserts right after ResolveProjectReferences's own, much earlier,
    invocation (confirmed live: target id ~46 of ~1750, versus GetVsixSourceItems at id ~1711) - the
    same target that actually builds a ReferenceOutputAssembly=false ProjectReference via its own
    <MSBuild> task, so items are created dynamically at EXECUTION time, once the exe is guaranteed to
    be on disk, well before GetVsixSourceItems collects them - not matched once at evaluation time
    (too early, exe does not exist yet) and not added too late either (past GetVsixSourceItems).
    Verified live end to end: a genuinely clean `msbuild Kubuno.VisualStudio.sln -t:Restore` then
    `-t:Build` (no manual pre-build of Kubuno.Mcp.csproj) produced a Kubuno.VisualStudio.vsix whose
    tools\kubuno-vs-mcp\ contains kubuno-vs-mcp.exe and its full dependency closure. Every file
    Kubuno.Mcp's own build produces (kubuno-vs-mcp.exe/.dll/.deps.json/.runtimeconfig.json and its
    dependency DLLs, e.g. ModelContextProtocol*.dll) - it is a framework-dependent net8.0 exe, not
    self-contained, so all of these are required for it to actually run once shipped.
  -->
  <Target Name="KubunoAddMcpContent" AfterTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(KubunoMcpOutputDir)kubuno-vs-mcp.exe')"
           Text="kubuno-vs-mcp.exe not found under '$(KubunoMcpOutputDir)'. It should have been built automatically as part of this solution (src\Kubuno.Mcp\Kubuno.Mcp.csproj) - build that project first, or pass /p:KubunoMcpOutputDir=&lt;its output folder&gt;." />
    <ItemGroup>
      <KubunoMcpOutputFile Include="$(KubunoMcpOutputDir)**\*.*" />
      <Content Include="@(KubunoMcpOutputFile)">
        <IncludeInVSIX>true</IncludeInVSIX>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>tools\kubuno-vs-mcp\%(RecursiveDir)%(Filename)%(Extension)</Link>
      </Content>
    </ItemGroup>
  </Target>

  <!--
    docs/RSPROJ.md work package 5's SDK-distribution decision: `Kubuno.Rust.Sdk`'s packed .nupkg
    (see README.md's "Building Rust with MSBuild (.rsproj)" for how pack-sdk.ps1/dotnet pack
    produces it) ships INSIDE the VSIX under tools\SdkFeed\, exactly like kubuno-views-ls.exe or
