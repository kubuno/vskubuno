    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <!--
      Not published on NuGet: this assembly ships only inside the Visual Studio installation
      itself (CommonExtensions\Microsoft\OpenFolder), unlike the rest of the Open Folder
      workspace API (Microsoft.VisualStudio.Workspace(.Extensions), restored from NuGet below).
      It carries IVsCommandItem, which a build/rebuild/clean IFileContextAction implements to
      bind itself to VS's well-known Build/Rebuild/Clean command IDs (see
      Workspace\CargoBuildFileContextAction.cs). Private=False and SuppressFromVsix (below):
      resolved against the *running* VS's own copy at both compile and run time, never copied
      into the VSIX - the version here only needs to satisfy the compiler.
    -->
    <Reference Include="Microsoft.VisualStudio.Workspace.Extensions.VS">
      <!--
        $(VsInstallRoot) (defined by Microsoft.VsSDK.targets, imported below) rather than
        $(DevEnvDir): the latter is only set when MSBuild is itself launched from inside
        devenv.exe, which is not the case for a plain command-line build (see README).
      -->
      <HintPath>$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\OpenFolder\Microsoft.VisualStudio.Workspace.Extensions.VS.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Workspace.VSIntegration" Version="17.12.19" ExcludeAssets="runtime" />
    <!--
      Kubuno.Cargo (netstandard2.0) hard-depends on System.Text.Json 8.0.5, which - unlike
      Newtonsoft.Json - .NET Framework 4.8 does not ship: referencing it directly here (rather
      than relying on it flowing transitively from the Kubuno.Cargo ProjectReference below) is
      what makes NuGet's own version-unification keep a runtime copy of it, and its netstandard2.0
      polyfill closure (System.Buffers/System.Memory/System.Numerics.Vectors/
      System.Runtime.CompilerServices.Unsafe/System.Threading.Tasks.Extensions/
      System.Text.Encodings.Web), actually inside this VSIX - verified by inspecting the built
      .vsix's zip contents (see the phase 1b/1c report).
    -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="EnvDTE" Version="17.14.40260" ExcludeAssets="runtime" />
    <SuppressFromVsix Include="Microsoft.VisualStudio.Workspace.dll" />
    <SuppressFromVsix Include="Microsoft.VisualStudio.Workspace.Extensions.dll" />
    <SuppressFromVsix Include="Microsoft.VisualStudio.Workspace.Extensions.VS.dll" />
    <SuppressFromVsix Include="Microsoft.VisualStudio.Workspace.VSIntegration.Contracts.dll" />
    <SuppressFromVsix Include="Microsoft.VisualStudio.Debugger.Interop*.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kubuno.VisualStudio.Core\Kubuno.VisualStudio.Core.csproj">
