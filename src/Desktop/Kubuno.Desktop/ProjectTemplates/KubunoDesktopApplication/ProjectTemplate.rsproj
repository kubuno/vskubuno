<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!-- Generated by Visual Studio's "Create a new project" (Kubuno Desktop Application template,
       docs/RSPROJ.md Addendum, lot 7). This file is yours: edit it freely. -->
  <PropertyGroup>
    <CargoPackage>$cratename$</CargoPackage>

    <!-- The Kubuno desktop Cargo workspace, and the folder of the framework's Windows crates this project's
         Cargo.toml path dependencies point at (keep both in sync). Resolved at project creation from
         KUBUNO_DESKTOP_SRC (a kubuno/core checkout: desktop/windows). -->
    <KubunoDesktopSrc Condition="'$(KubunoDesktopSrc)' == ''">$kubunodesktopsrc$</KubunoDesktopSrc>
    <KubunoDesktopCrates Condition="'$(KubunoDesktopCrates)' == ''">$kubunodesktopcrates$</KubunoDesktopCrates>

    <!-- This project's OWN cargo target directory, so that its builds never wait on, or clean, the
         desktop workspace's (e.g. a machine-wide CARGO_TARGET_DIR that the desktop workspace also
         builds into). When CARGO_TARGET_DIR is set (a local disk for sources on a network share), this
         project gets a subfolder of it; otherwise cargo's usual <project>\target. -->
    <CargoTargetDir Condition="'$(CARGO_TARGET_DIR)' != ''">$(CARGO_TARGET_DIR)\rsproj\$(CargoPackage)</CargoTargetDir>
    <CargoTargetDir Condition="'$(CARGO_TARGET_DIR)' == ''">$(MSBuildProjectDirectory)\target</CargoTargetDir>
  </PropertyGroup>

  <!-- Stops early, with a message that says what to do, when the desktop sources are missing
       (instead of cargo's "failed to read ...\Cargo.toml"). -->
  <Target Name="KubunoCheckDesktopSources" BeforeTargets="CargoRestore;CoreCompile">
    <Error Condition="!Exists('$(KubunoDesktopCrates)/kubuno-desktop-ui/Cargo.toml')"
           Code="KUBUNO0001"
           Text="The Kubuno desktop sources were not found at '$(KubunoDesktopCrates)'. This project builds against a local checkout of github.com/kubuno/core (its 'desktop/windows' folder holds the framework). Clone it, then either set the KUBUNO_DESKTOP_SRC environment variable to that checkout before creating a project, or point &lt;KubunoDesktopCrates&gt; in this .rsproj and the kubuno-desktop path in Cargo.toml at its desktop/windows folder." />
  </Target>

</Project>
