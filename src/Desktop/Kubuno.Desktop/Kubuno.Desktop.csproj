<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A class library (net48, MEF-free WindowPane/editor factory code), not a VSIX project of its own:
    it declares no source.extension.vsixmanifest and generates no pkgdef, and is never installed or
    loaded standalone. It exists to be REFERENCED by the Kubuno.VisualStudio VSIX project later (see
    INTEGRATION.md) - the same "standalone library, wired in a later step" shape already used by
    src/Kubuno.VisualStudio.Views (see that project's own csproj top comment), and for the same
    reason: it must not reference Kubuno.VisualStudio or Kubuno.VisualStudio.Core (a reference the
    other way would be circular once integrated), and its package versions are pinned to match
    Kubuno.VisualStudio.csproj's own so no binding-redirect surprises appear once referenced.

    It DOES reference Kubuno.VisualStudio.Views (a sibling library, not the VSIX): the "kbview"
    content type/file extension constants and the existing IKubunoLog/KubunoViewsLogHost logging
    gateway already live there, and duplicating them here would be a second, driftable copy of the
    same string ("kbview") this whole editor is keyed on. That reference is not circular: Views does
    not, and must not, reference this project back.

    TargetFramework is net48 to match the VSIX's own in-proc runtime (classic VSSDK extensions are
    .NET Framework 4.8) and to let Microsoft.VisualStudio.Shell.WindowPane/DialogPage and WPF types
    (System.Windows.Interop.HwndHost) resolve without any shims. No .xaml files are used anywhere in
    this project, matching the rest of this repo (grep confirms no *.xaml exists in vskubuno today):
    all WPF UI here is built in code-behind, so no XAML markup-compile target is needed on top of the
    plain SDK-style net48 setup.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.VisualStudio.Designer</RootNamespace>
    <AssemblyName>Kubuno.VisualStudio.Designer</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Same versions as src\Kubuno.VisualStudio\Kubuno.VisualStudio.csproj and
      src\Kubuno.VisualStudio.Views\Kubuno.VisualStudio.Views.csproj (verified by reading both before
      writing this one - bump all three together if the VSIX project's own versions ever change).
      Microsoft.VisualStudio.SDK already carries Microsoft.VisualStudio.Shell.Interop and
      Microsoft.VisualStudio.TextManager.Interop (IVsEditorFactory, IVsCodeWindow, IVsTextLines,
      VsCodeWindowClass/VsTextBufferClass) - no separate TextManager.Interop package reference is
      needed on top of it.
    -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kubuno.VisualStudio.Views\Kubuno.VisualStudio.Views.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="INTEGRATION.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The themed dialog base shared as source by every assembly that shows a dialog (docs/ARCHITECTURE.md, "Themed dialogs"). -->
    <Compile Include="..\Shared\UI\*.cs" Link="UI\Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
