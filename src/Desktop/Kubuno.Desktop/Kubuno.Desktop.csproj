<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Desktop layer, Visual Studio side (docs/ARCHITECTURE.md, "Layers (as built)"): everything that exists because the
    target is a Kubuno desktop application (kubuno_ui, Rust code-behind):
      - Designer\DesignSurface\  the Design pane's renderer: RustDesignSurfaceHost (view_embed.exe hosted in an HwndHost,
                    the kubuno_ui runtime handshake) and its factory, the desktop implementation of the views layer's
                    IProtocolDesignSurfaceHost (docs/DESIGNER.md; docs/WEB-VIEWS.md WV-8);
      - Designer\Bindings\BindingDropPlanner  the Data Sources window's drop of a bindable member;
      - DesignerIntegration\  the design surface locator and the per-project design runtime (docs/DESIGNER.md 15);
      - LanguageService\      what .kbview adds to Rust files (cross-language completion and navigation, override
                              members, SQL in Rust strings);
      - DataExplorer\, DataSources\, Migrations\, Options\DataOptionsPage  the data tooling (docs/DATA.md);
      - Commands\   the paint debug command; DesktopLayer.cs wires all of it into the package.
    The designer itself (Toolbox, Properties, events, pickers...), the .kbview language client and the .kbres editor are
    the views layer's (src\Views\Kubuno.Views), shared with the web target. Printing (docs/PRINTING.md) is served by the
    same designer/Toolbox code (library component tabs).

    References Shared, Rust and Views only - never Web or Mobile (enforced by tests/Kubuno.Architecture.Tests). The CPS
    part of the target (.kbview default editor, file icon, Kubuno control icons) is Kubuno.Desktop.ProjectSystem; the
    control item wizard is Kubuno.Desktop.TemplateWizard; the pure logic is Kubuno.Desktop.Logic.

    net48 like every in-proc Visual Studio assembly of the extension. All WPF UI is built in code-behind (no XAML
    markup compile needed).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.Desktop</RootNamespace>
    <AssemblyName>Kubuno.Desktop</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Same benign MSB3277 unification notes as Kubuno.VisualStudio (see its csproj). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- $(VsInstallRoot) is only defined by Microsoft.VsSDK.targets (VSIX projects); resolved like the wizards do. -->
    <VsInstallRoot Condition="'$(VsInstallRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)\..\..\..'))</VsInstallRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Windows.Forms" />
    <!-- Open Folder's IVsCommandItem & co., shipped only inside Visual Studio (see Kubuno.Rust.csproj). -->
    <Reference Include="Microsoft.VisualStudio.Workspace.Extensions.VS">
      <HintPath>$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\OpenFolder\Microsoft.VisualStudio.Workspace.Extensions.VS.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as every other Visual Studio assembly of the extension (bump them together). -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Workspace.VSIntegration" Version="17.12.19" ExcludeAssets="runtime" />
    <PackageReference Include="EnvDTE" Version="17.14.40260" ExcludeAssets="runtime" />
    <PackageReference Include="EnvDTE80" Version="17.14.40260" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Kubuno.Shared\Kubuno.Shared.csproj" />
    <ProjectReference Include="..\..\Shared\Kubuno.Shared.Logic\Kubuno.Shared.Logic.csproj" />
    <!-- docs/AI-ASSISTANT.md: the Dev Assistant's contracts (DevAssistant\: #élément, /vue, the .kbview tools). -->
    <ProjectReference Include="..\..\Shared\Kubuno.Shared.DevAssistant\Kubuno.Shared.DevAssistant.csproj" />
    <ProjectReference Include="..\..\Shared\Kubuno.Shared.DevAssistant.Logic\Kubuno.Shared.DevAssistant.Logic.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust\Kubuno.Rust.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.Logic\Kubuno.Rust.Logic.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.Cargo\Kubuno.Rust.Cargo.csproj" />
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.Launch\Kubuno.Rust.Launch.csproj" />
    <!-- docs/WEB-VIEWS.md WV-8: the view designer, the .kbview language client and the .kbres editor this layer renders for. -->
    <ProjectReference Include="..\..\Views\Kubuno.Views\Kubuno.Views.csproj" />
    <ProjectReference Include="..\..\Views\Kubuno.Views.Logic\Kubuno.Views.Logic.csproj" />
    <ProjectReference Include="..\Kubuno.Desktop.Logic\Kubuno.Desktop.Logic.csproj" />
    <!-- The control item names (the "Ajouter" commands name files like the wizard) and its preload. -->
    <ProjectReference Include="..\Kubuno.Desktop.TemplateWizard\Kubuno.Desktop.TemplateWizard.csproj" />
  </ItemGroup>

</Project>
