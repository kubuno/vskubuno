<?xml version="1.0" encoding="utf-8"?>
<!-- docs/EVENTS.md EVT-7b: "Add New Item > Kubuno Custom Control" - an owner-drawn control (a class of the Control
     level drawn by its own on_paint), usable as an element of the project's views. The wizard names the struct
     (PascalCase) after the entered name (the file keeps it) and declares its module in the crate root. -->
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Kubuno Custom Control (Kubuno Desktop)</Name>
    <Description>A control drawn by its own on_paint (WinForms: a class deriving from Control that overrides OnPaint), usable as an element of the project's views and listed in the Toolbox after a build.</Description>
    <ProjectType>Rust</ProjectType>
    <TemplateID>Kubuno.Rust.KubunoCustomControl</TemplateID>
    <LanguageTag>Rust</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Kubuno</ProjectTypeTag>
    <ProjectTypeTag>Kubuno Desktop</ProjectTypeTag>
    <Icon>__TemplateIcon.png</Icon>
    <SortOrder>11</SortOrder>
    <DefaultName>CustomControl.rs</DefaultName>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.rs">CustomControl.rs</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>Kubuno.Desktop.TemplateWizard, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>Kubuno.Desktop.TemplateWizard.ControlItemWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
