<?xml version="1.0" encoding="utf-8"?>
<!--
  "Add New Item > Kubuno Dialog": A modal dialog. A .kbview (its design) and its code, a #[kubuno::view] struct,
  SAME STEM so Solution Explorer nests the code under the view (docs/PROGRAMMING-MODEL.md).
  ControlItemWizard names the struct ($classname$) and the load handler ($modulename$) and declares the module.
-->
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Kubuno Dialog (Kubuno Core Desktop)</Name>
    <Description>A modal dialog in the Kubuno look (the web FloatingWindow): a title band with a close button, a body, and an action bar with its confirm and cancel buttons. Open it with show_dialog, which returns its DialogResult.</Description>
    <ProjectType>Rust</ProjectType>
    <TemplateID>Kubuno.Rust.KubunoDialog</TemplateID>
    <LanguageTag>Rust</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Kubuno</ProjectTypeTag>
    <ProjectTypeTag>Kubuno Core Desktop</ProjectTypeTag>
    <Icon>__TemplateIcon.png</Icon>
    <SortOrder>13</SortOrder>
    <DefaultName>NewDialog.kbview</DefaultName>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.kbview">View.kbview</ProjectItem>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.rs">View.rs</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>Kubuno.Desktop.TemplateWizard, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>Kubuno.Desktop.TemplateWizard.ControlItemWizard</FullClassName>
  </WizardExtension>
</VSTemplate>