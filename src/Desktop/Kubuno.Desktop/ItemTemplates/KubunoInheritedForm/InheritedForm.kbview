<!--
  $fileinputname$.kbview - the form $classname$, inheriting $baseview$ (a Windows Forms inherited form): it shows every
  control of the base form. The controls the base makes Protected or Public are listed below: set their properties here
  (the base keeps the others, locked). Add the new form's own controls after them.
-->
<$baseroot$ xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" x:Inherits="$baseview$" Title="$classname$">
$overrides$</$baseroot$>
