<?xml version="1.0" encoding="utf-8"?>
<!-- docs/EVENTS.md "User controls", visual inheritance: "Add New Item > Kubuno Inherited Form" - Windows Forms' Inherited
     Form. InheritedViewWizard asks which form of the project to inherit from (its Inheritance Picker) and writes a view
     naming it (x:Inherits) with an element for each control of the base the new form may change (Modifiers Protected or
     Public), and the code-behind holding the base form (#[base]). -->
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Kubuno Inherited Form (Kubuno Core Desktop)</Name>
    <Description>A form that inherits another form of the project: it shows the base form's controls, can change those the base makes Protected or Public, adds its own, and keeps the base form's event handlers - like a Windows Forms Inherited Form.</Description>
    <ProjectType>Rust</ProjectType>
    <TemplateID>Kubuno.Rust.KubunoInheritedForm</TemplateID>
    <LanguageTag>Rust</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Kubuno</ProjectTypeTag>
    <ProjectTypeTag>Kubuno Core Desktop</ProjectTypeTag>
    <Icon>__TemplateIcon.png</Icon>
    <SortOrder>11</SortOrder>
    <DefaultName>InheritedForm.kbview</DefaultName>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.kbview">InheritedForm.kbview</ProjectItem>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.rs">InheritedForm.rs</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>Kubuno.Desktop.TemplateWizard, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>Kubuno.Desktop.TemplateWizard.InheritedViewWizard</FullClassName>
  </WizardExtension>
  <WizardData>
    <KubunoInherited kind="form" />
  </WizardData>
</VSTemplate>
