<!--
  $fileinputname$.kbview - the application's splash screen: a large, artwork-led startup window
  (WindowKind="Splash": no border, centred, top-most, no task bar button).

  The <SplashArtwork> draws Kubuno's procedural artwork - the module's ground, motif and hero mark,
  the product name and version, a status line with a thin progress bar, the legal lines. Pick the
  artwork (Kubuno, Drive, Chat, Documents) and set Product, Tagline and Credits in the Properties
  window: the designer shows the result as it will appear.

  At start-up, $classname$::show_at_startup() shows it at once, on its own thread, from this design
  (kubuno_desktop::splash::from_kbview); SplashDuration is then the shortest time it stays on screen.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="800" DesignHeight="500" Title="$classname$" WindowKind="Splash" SplashDuration="1500" OnLoad="$modulename$_load">
  <SplashArtwork x:Name="artwork" Artwork="Kubuno" Product="" Tagline="" Version="Version 0.1.0" Status="Initialisation des modules…" Progress="0.35" Dock="Fill"/>
</Panel>
