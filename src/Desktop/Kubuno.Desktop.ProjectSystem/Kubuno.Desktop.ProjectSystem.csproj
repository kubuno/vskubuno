<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Desktop layer, CPS part (docs/ARCHITECTURE.md, "Layers (as built)"): what the desktop target adds to a .rsproj in
    Solution Explorer, as MEF exports scoped with [AppliesTo] to the RustProjectSystem capability, next to
    Kubuno.Rust.ProjectSystem's own exports - the Kubuno View Designer as the default editor of .kbview items
    (KbviewDesignerEditorProvider), the .kbview item icon (KbviewTreePropertiesProvider) - and the Kubuno control
    icons (Resources\Icons\Controls, Resources\KubunoControls.imagemanifest, generated by
    tools/generate-control-icons.ps1): WPF resources the image service loads by assembly name, used by the Toolbox and
    by the .kbview element nodes of Solution Explorer.

    Compiled against the running Visual Studio's own CPS and Shell assemblies, never shipped (same reasoning as
    Kubuno.Rust.ProjectSystem.csproj).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kubuno.Desktop.ProjectSystem</RootNamespace>
    <AssemblyName>Kubuno.Desktop.ProjectSystem</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- WPF resources: the control icons (XAML) reachable through the pack URI of KubunoControls.imagemanifest. -->
    <UseWPF>true</UseWPF>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <KubunoVsInstallDir Condition="'$(KubunoVsInstallDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)\..\..\..'))\</KubunoVsInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="Microsoft.VisualStudio.ProjectSystem">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- IProjectSpecificEditorProvider (the .kbview default editor) lives in CPS's VS-side assembly. -->
    <Reference Include="Microsoft.VisualStudio.ProjectSystem.VS">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\CommonExtensions\Microsoft\Project\Microsoft.VisualStudio.ProjectSystem.VS.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Interop">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Interop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Threading">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Collections.Immutable">
      <HintPath>$(KubunoVsInstallDir)Common7\IDE\PublicAssemblies\System.Collections.Immutable.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- RustProjectCapabilities (the [AppliesTo] expression) and RustProjectImages (the .kbview item icon moniker). -->
    <ProjectReference Include="..\..\Rust\Kubuno.Rust.ProjectSystem\Kubuno.Rust.ProjectSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\KubunoControls.imagemanifest" />
  </ItemGroup>

</Project>
