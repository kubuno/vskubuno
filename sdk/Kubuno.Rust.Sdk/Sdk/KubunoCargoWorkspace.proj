<Project DefaultTargets="Build">

  <!--
    The one cargo build of a whole Cargo workspace, shared by every .rsproj of that workspace whose
    CargoBuildScope is "Workspace" (see Sdk.targets, CoreCompile). Each such project calls this file
    through the MSBuild task with the same global properties (workspace manifest, profile, target
    directory, flags), and MSBuild builds a given project + global properties only once per build
    session: a solution build therefore runs one workspace-wide `cargo build`, reports its errors once,
    and hands the same list of executables back to every project, which picks its own.

    Why a workspace-wide build at all: a workspace with a Rust dylib must build the dylib and every
    program loading it together. With resolver 2, the features of a dependency depend on which
    packages a command selects, and cargo names a dylib without a hash, so `cargo build -p app-a` and
    `cargo build -p app-b` rebuild the same deps\<name>.dll with different features in turn, leaving
    the other program linked against a DLL that no longer matches it (docs/RSPROJ.md, "Cargo
    workspaces"). A workspace may also opt in (CargoBuildScope=Workspace) just to have a solution
    build run one cargo build, as the Kubuno desktop workspace does (its kubuno-ui is an rlib, linked
    statically, since 2026-10-03).

    Never imported: an ordinary project file, only ever built through the MSBuild task.
  -->

  <PropertyGroup>
    <_KubunoCargoTasksTfm Condition="'$(_KubunoCargoTasksTfm)' == '' and '$(MSBuildRuntimeType)' == 'Full'">net472</_KubunoCargoTasksTfm>
    <_KubunoCargoTasksTfm Condition="'$(_KubunoCargoTasksTfm)' == ''">net10.0</_KubunoCargoTasksTfm>
    <_KubunoCargoTasksAssembly Condition="'$(_KubunoCargoTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\tasks\$(_KubunoCargoTasksTfm)\Kubuno.Cargo.MSBuild.Tasks.dll</_KubunoCargoTasksAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Kubuno.Cargo.MSBuild.Tasks.CargoBuild" AssemblyFile="$(_KubunoCargoTasksAssembly)" />

  <ItemGroup>
    <_KubunoCargoFeature Include="$(CargoFeatures)" />
    <!-- Keep going past a crate that fails: one broken program must not keep the others (and their
         errors) from being built, so every error of the workspace reaches the Error List in one build,
         and a program that did build can still be started ("run the last successful build"). -->
    <_KubunoWorkspaceBuildArg Include="--keep-going" />
    <_KubunoWorkspaceBuildArg Include="$(CargoWorkspaceBuildArgs)" />
  </ItemGroup>

  <!--
    Returns one list, told apart by the KubunoKind metadata: every [[bin]] executable ("Executable",
    with BinName), every error and warning ("Diagnostic", see CargoBuild.Diagnostics) and one
    "Result" item (Succeeded). The errors are not logged here: this project is not part of the
    solution, so Visual Studio would show them in the Output window only. Each calling project logs
    the ones of its own files instead (KubunoWorkspaceDiagnostics), so the target itself never fails
    because of a compile error.
  -->
  <Target Name="Build" Returns="@(_KubunoWorkspaceResult)">
    <CargoBuild ManifestPath="$(CargoWorkspaceManifestPath)"
                Workspace="true"
                DiagnosticsAsItems="true"
                Profile="$(CargoProfile)"
                TargetDir="$(CargoTargetDir)"
                Features="@(_KubunoCargoFeature)"
                NoDefaultFeatures="$(CargoNoDefaultFeatures)"
                AllFeatures="$(CargoAllFeatures)"
                TargetTriple="$(CargoTargetTriple)"
                RustFlags="$(KubunoRustFlags)"
                ExtraArgs="@(_KubunoWorkspaceBuildArg)"
                WorkspaceRoot="$(CargoWorkspaceRoot)"
                WorkingDirectory="$(CargoWorkspaceRoot)">
      <Output TaskParameter="Executables" ItemName="_KubunoWorkspaceExecutable" />
      <Output TaskParameter="Diagnostics" ItemName="_KubunoWorkspaceDiagnostic" />
      <Output TaskParameter="Succeeded" PropertyName="_KubunoWorkspaceSucceeded" />
    </CargoBuild>
    <ItemGroup>
      <_KubunoWorkspaceResult Include="@(_KubunoWorkspaceExecutable)" KubunoKind="Executable" />
      <_KubunoWorkspaceResult Include="@(_KubunoWorkspaceDiagnostic)" KubunoKind="Diagnostic" />
      <_KubunoWorkspaceResult Include="result" KubunoKind="Result" Succeeded="$(_KubunoWorkspaceSucceeded)" />
    </ItemGroup>
  </Target>

  <!-- `cargo clean` of the profile, once per build session (a Rebuild of N projects must not clean N times). -->
  <Target Name="Clean">
    <PropertyGroup>
      <_KubunoCleanProfileArg Condition="'$(CargoProfile)' == 'debug' or '$(CargoProfile)' == ''">--profile dev</_KubunoCleanProfileArg>
      <_KubunoCleanProfileArg Condition="'$(CargoProfile)' == 'release'">--release</_KubunoCleanProfileArg>
      <_KubunoCleanProfileArg Condition="'$(_KubunoCleanProfileArg)' == ''">--profile $(CargoProfile)</_KubunoCleanProfileArg>
      <_KubunoCleanProfileArg Condition="'$(CargoTargetTriple)' != ''">$(_KubunoCleanProfileArg) --target $(CargoTargetTriple)</_KubunoCleanProfileArg>
    </PropertyGroup>
    <Exec Command="cargo clean --manifest-path &quot;$(CargoWorkspaceManifestPath)&quot; $(_KubunoCleanProfileArg)"
          WorkingDirectory="$(CargoWorkspaceRoot)"
          EnvironmentVariables="CARGO_TARGET_DIR=$(CargoTargetDir)"
          Condition="'$(CargoTargetDir)' != ''" />
    <Exec Command="cargo clean --manifest-path &quot;$(CargoWorkspaceManifestPath)&quot; $(_KubunoCleanProfileArg)"
          WorkingDirectory="$(CargoWorkspaceRoot)"
          Condition="'$(CargoTargetDir)' == ''" />
  </Target>

</Project>
