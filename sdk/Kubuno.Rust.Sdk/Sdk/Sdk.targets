<Project>

  <!--
    Kubuno.Rust.Sdk's implicit BOTTOM import (docs/RSPROJ.md Â§2). Structured like
    Microsoft.VisualStudio.JavaScript.SDK's own Sdk.targets: project configurations, capabilities
    and rule files for Visual Studio's Common Project System (work package 3), the cargo-specific
    overrides that must precede Microsoft.Common.targets (CoreCompile), the Microsoft.Common.targets
    import itself, then the overrides that must follow it.
  -->

  <!--
    Plain UsingTask, no Runtime/Architecture hints: loading the task assembly from Z: (this
    workspace's mapped network drive) fails under `dotnet build` (MSB4061) â€” the SDK is therefore
    distributed as a NuGet package, restored into the LOCAL package cache, so
    $(_KubunoCargoTasksAssembly) always resolves to a local (C:) path (see Kubuno.Rust.Sdk.csproj).
  -->
  <UsingTask TaskName="Kubuno.Cargo.MSBuild.Tasks.CargoBuild" AssemblyFile="$(_KubunoCargoTasksAssembly)" />
  <UsingTask TaskName="Kubuno.Cargo.MSBuild.Tasks.CargoTest" AssemblyFile="$(_KubunoCargoTasksAssembly)" />
  <UsingTask TaskName="Kubuno.Cargo.MSBuild.Tasks.CargoFetch" AssemblyFile="$(_KubunoCargoTasksAssembly)" />
  <UsingTask TaskName="Kubuno.Cargo.MSBuild.Tasks.CargoClippy" AssemblyFile="$(_KubunoCargoTasksAssembly)" />
  <UsingTask TaskName="Kubuno.Cargo.MSBuild.Tasks.KubunoWin32Resources" AssemblyFile="$(_KubunoCargoTasksAssembly)" />

  <!-- The two configurations Visual Studio's Configuration Manager/toolbar dropdown offer
       (capability ProjectConfigurationsDeclaredAsItems below), mapped to cargo's dev/release
       profiles further down. x64 only: see $(Platform) in Sdk.props. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!--
    Capabilities (docs/RSPROJ.md Â§3), copied from the JS SDK's own list, plus RustProjectSystem
    (the JS SDK's JSProjectSystem counterpart) that the VSIX's CPS exports key their
    [AppliesTo] off. Conditions must only ever depend on configuration/platform.
  -->
  <ItemGroup>
    <ProjectCapability Include="RustProjectSystem" />
    <ProjectCapability Include="UseFileGlobs" />
    <ProjectCapability Include="OpenProjectFile" />
    <ProjectCapability Include="HandlesOwnReload" />
    <ProjectCapability Include="ProjectConfigurationsDeclaredAsItems" />
    <ProjectCapability Include="ProjectPropertiesEditor" />
    <ProjectCapability Include="ProjectPropertyInterception" />
    <ProjectCapability Include="AvoidAddingProjectGuid" />
    <ProjectCapability Include="ConfigurableFileNesting" />
    <ProjectCapability Include="DynamicFileNesting" />
    <ProjectCapability Include="DynamicFileNestingEnabled" />
    <ProjectCapability Include="DynamicDependentFile" />
    <ProjectCapability Include="NoGeneralDependentFileIcon" />
  </ItemGroup>

  <!-- Default item globbing switches (the glob itself is in Sdk.props), overridable by the project. -->
  <PropertyGroup>
    <EnableDefaultItems Condition="'$(EnableDefaultItems)' == ''">true</EnableDefaultItems>
    <EnableDefaultNoneItems Condition="'$(EnableDefaultNoneItems)' == ''">true</EnableDefaultNoneItems>

    <!-- MSBuild's own intermediate/output folders and cargo's default target dir. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;target/**</DefaultItemExcludes>
    <!-- Various files that should generally always be ignored (same list as the JS SDK). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.user;**/*.*proj;**/*.sln;**/*.slnx;**/*.vssscc;**/*.rs.bk</DefaultItemExcludes>
    <!-- Dot-folders (.git, .vs, .cargo, .idea, ...). As the JS SDK warns, this pattern would also
         match items included with a relative path outside the project folder, so it is only ever
         applied to the project-folder glob. -->
    <DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);**/.*/**</DefaultExcludesInProjectFolder>
  </PropertyGroup>

  <!--
    View / code-behind nesting (docs/RSPROJ.md, lot 8): a `x.rs` sitting in the same folder as a
    `x.kbview` is shown under it in Solution Explorer, like WPF's MainWindow.xaml > MainWindow.xaml.cs
    (Rust module names cannot contain dots, so the pairing is by stem). Only DependentUpon metadata is
    added to the items the default glob already produced - no hand-written item list, Cargo.toml stays
    the truth. Opt out with <EnableKbviewCodeBehindNesting>false</EnableKbviewCodeBehindNesting>.
  -->
  <PropertyGroup>
    <EnableKbviewCodeBehindNesting Condition="'$(EnableKbviewCodeBehindNesting)' == ''">true</EnableKbviewCodeBehindNesting>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableKbviewCodeBehindNesting)' == 'true'">
    <None Update="**/*.rs">
      <DependentUpon Condition="'%(None.DependentUpon)' == '' and Exists('%(None.RootDir)%(None.Directory)%(None.Filename).kbview')">%(None.Filename).kbview</DependentUpon>
    </None>
  </ItemGroup>

  <!--
    .kbview files are designer documents (docs/DESIGNER.md §11), like a WinForms form or a WPF window:
    SubType="Designer" is the item metadata the project system reads (CPS's HasDesigner check) to
    offer "View Designer" (Shift+F7) and "View Code" (F7) on them in Solution Explorer, and "View
    Designer" on their nested code-behind .rs. A project may override it per item.
  -->
  <ItemGroup>
    <None Update="**/*.kbview">
      <SubType Condition="'%(None.SubType)' == ''">Designer</SubType>
    </None>
  </ItemGroup>

  <!--
    Rule files (docs/RSPROJ.mdÂ§3): what CPS uses to know the item types it displays, and the
    project/file property pages. Neutral language only (no localized copies yet).
  -->
  <PropertyGroup>
    <KubunoRustSdkRulesDirectory Condition="'$(KubunoRustSdkRulesDirectory)' == ''">$(MSBuildThisFileDirectory)Rules</KubunoRustSdkRulesDirectory>
  </PropertyGroup>

  <!--
    Localized pages of the Project Properties editor (docs/RSPROJ.md, "Project properties like .NET"):
    Rules\<culture>\rust_*.xaml hold the same rules with translated display names, descriptions and
    messages. Visual Studio passes its UI language as LangName/LangID to design-time evaluations; the
    probing is the one Microsoft.Managed.DesignTime.targets uses for the .NET pages (exact culture, then
    the neutral culture, then the English files next to this one).
  -->
  <PropertyGroup Condition="'$(KubunoRustSdkPagesDirectory)' == ''">
    <KubunoRustSdkPagesDirectory>$(KubunoRustSdkRulesDirectory)\$(LangName)</KubunoRustSdkPagesDirectory>
    <KubunoRustSdkPagesDirectory Condition="'$(LangName)' == '' or !Exists('$(KubunoRustSdkPagesDirectory)\rust_application.xaml')">$(KubunoRustSdkRulesDirectory)\$(LangName.Split('-')[0])</KubunoRustSdkPagesDirectory>
    <KubunoRustSdkPagesDirectory Condition="'$(LangName)' == '' or !Exists('$(KubunoRustSdkPagesDirectory)\rust_application.xaml')">$(KubunoRustSdkRulesDirectory)</KubunoRustSdkPagesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PropertyPageSchema Include="$(KubunoRustSdkRulesDirectory)\ProjectItemsSchema.xaml" />
    <PropertyPageSchema Include="$(KubunoRustSdkRulesDirectory)\general.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <!-- The Project Properties editor's pages (a document tab like .NET's, opened by Properties on the project). -->
    <PropertyPageSchema Include="$(KubunoRustSdkPagesDirectory)\rust_application.xaml;$(KubunoRustSdkPagesDirectory)\rust_build.xaml;$(KubunoRustSdkPagesDirectory)\rust_package.xaml;$(KubunoRustSdkPagesDirectory)\rust_codeanalysis.xaml;$(KubunoRustSdkPagesDirectory)\rust_debug.xaml;$(KubunoRustSdkPagesDirectory)\rust_resources.xaml;$(KubunoRustSdkPagesDirectory)\rust_settings.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <!-- F5/Ctrl+F5 (work package 4): CPS reads DebuggerFlavor through debugger_general.xaml;
         rust_debugger.xaml is the "debugger" rule named after it - the Start button's label AND
         the arguments/working dir/env properties shown under the "Debug" page when it is the
         selected flavor (no separate page). -->
    <PropertyPageSchema Include="$(KubunoRustSdkRulesDirectory)\debugger_general.xaml;$(KubunoRustSdkRulesDirectory)\rust_debugger.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(KubunoRustSdkRulesDirectory)\general_file.xaml">
      <Context>File</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(KubunoRustSdkRulesDirectory)\scc.xaml">
      <Context>Invisible</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(KubunoRustSdkRulesDirectory)\folder.xaml;$(KubunoRustSdkRulesDirectory)\none.xaml">
      <Context>File;BrowseObject</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(KubunoRustSdkRulesDirectory)\general.browseobject.xaml">
      <Context>BrowseObject</Context>
    </PropertyPageSchema>
  </ItemGroup>

  <PropertyGroup>
    <_KubunoManifestDir>$([System.IO.Path]::GetDirectoryName('$(CargoManifestPath)'))</_KubunoManifestDir>

    <!--
      Debug/Release map onto cargo's two built-in profiles (docs/RSPROJ.md Â§2); any other
      $(Configuration) is passed straight through as a custom cargo profile name (see
      CargoCommand.WithProfile). An explicit $(CargoProfile) always wins.
    -->
    <CargoProfile Condition="'$(CargoProfile)' == '' and '$(Configuration)' == 'Debug'">debug</CargoProfile>
    <CargoProfile Condition="'$(CargoProfile)' == '' and '$(Configuration)' == 'Release'">release</CargoProfile>
    <CargoProfile Condition="'$(CargoProfile)' == ''">$(Configuration.ToLowerInvariant())</CargoProfile>

    <!-- Cargo's own on-disk directory name for $(CargoProfile) ("debug"/"release" are already their
         own directory names â€” see Kubuno.Launch.CargoLayout.ResolveProfileDirectoryName). -->
    <CargoProfileDirName>$(CargoProfile)</CargoProfileDirName>

    <!-- Effective target dir (mirrors Kubuno.Launch.CargoLayout.ResolveTargetDir): an explicit
         $(CargoTargetDir)/CARGO_TARGET_DIR wins outright, else "<manifest dir>/target". -->
    <_KubunoEffectiveTargetDir Condition="'$(CargoTargetDir)' != ''">$(CargoTargetDir)</_KubunoEffectiveTargetDir>
    <_KubunoEffectiveTargetDir Condition="'$(_KubunoEffectiveTargetDir)' == ''">$(_KubunoManifestDir)\target</_KubunoEffectiveTargetDir>

    <!-- The bin target's own name: $(CargoBin), else $(CargoPackage), else the .rsproj's own name. -->
    <_KubunoBinName Condition="'$(CargoBin)' != ''">$(CargoBin)</_KubunoBinName>
    <_KubunoBinName Condition="'$(_KubunoBinName)' == '' and '$(CargoPackage)' != ''">$(CargoPackage)</_KubunoBinName>
    <_KubunoBinName Condition="'$(_KubunoBinName)' == ''">$(MSBuildProjectName)</_KubunoBinName>

    <!--
      Output location, expressed through Microsoft.Common's own properties so its TargetDir/
      TargetPath computation lands on cargo's artifact (docs/RSPROJ.md Â§2: unlike the JS SDK, a
      .rsproj has one real executable): <target dir>\<profile>\<bin>.exe â€” the same convention
      Kubuno.Launch.ExecutableResolver falls back to. CoreCompile below still overwrites
      $(TargetPath) with cargo's own authoritative compiler-artifact path whenever it runs.
    -->
    <OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
    <!-- cargo's target option (a triple) (Application page, "Target platform") nests the profile folder under the triple. -->
    <_KubunoTripleDir Condition="'$(CargoTargetTriple)' != ''">$(CargoTargetTriple)\</_KubunoTripleDir>
    <OutputPath>$(_KubunoEffectiveTargetDir)\$(_KubunoTripleDir)$(CargoProfileDirName)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <AssemblyName>$(_KubunoBinName)</AssemblyName>
    <TargetName>$(_KubunoBinName)</TargetName>
    <TargetExt>.exe</TargetExt>

    <!-- Microsoft.Common only knows how to copy managed .dll/.exe outputs; cargo already put the
         artifact where it belongs (the JS SDK sets the same switches for the same reason). -->
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <PublishableProject>false</PublishableProject>
    <TargetRuntime>None</TargetRuntime>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gate CoreCompile's own Inputs/Outputs check â€” cargo still does the fine-grained
         incremental work; this only decides whether to shell out to it at all. -->
    <_KubunoCargoSourceFiles Include="$(_KubunoManifestDir)\src\**\*.rs" Condition="Exists('$(_KubunoManifestDir)\src')" />
    <!-- docs/DATA.md DATA-7: what `data_source!` reads at compile time (the .kbdata files and the offline query cache),
         and the migrations its stale-cache warning compares that cache with - a change to any of them must reach cargo. -->
    <_KubunoCargoSourceFiles Include="$(_KubunoManifestDir)\src\**\*.kbdata" Condition="Exists('$(_KubunoManifestDir)\src')" />
    <_KubunoCargoSourceFiles Include="$(_KubunoManifestDir)\.sqlx\*.json" Condition="Exists('$(_KubunoManifestDir)\.sqlx')" />
    <_KubunoCargoSourceFiles Include="$(_KubunoManifestDir)\migrations\*.sql" Condition="Exists('$(_KubunoManifestDir)\migrations')" />
    <_KubunoCargoLockFile Include="$(_KubunoManifestDir)\Cargo.lock" Condition="Exists('$(_KubunoManifestDir)\Cargo.lock')" />
  </ItemGroup>

  <!--
    Build page properties (docs/RSPROJ.md, "Project properties like .NET") turned into cargo arguments:
    features (a ';' list), and the rustc flags passed as one merged build.rustflags config override
    (RustFlags, then -D warnings for RustWarningsAsErrors, then one cfg flag per RustCfg entry).
  -->
  <ItemGroup>
    <_KubunoCargoFeature Include="$(CargoFeatures)" />
    <_KubunoRustCfg Include="$(RustCfg)" />
  </ItemGroup>
  <PropertyGroup>

    <!-- Win32 resources (Application page): the .res file is named after a hash of its content (see
         KubunoWin32Resources), so a changed icon/version changes cargo's arguments and relinks the exe. -->
    <_KubunoWin32ResourcesEnabled Condition="'$(KubunoWin32Resources)' == 'true' and '$(DesignTimeBuild)' != 'true'">true</_KubunoWin32ResourcesEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(KubunoWin32Resources)' == 'true'">
    <_KubunoWin32ResourceInput Include="$(KubunoApplicationIcon)" Condition="'$(KubunoApplicationIcon)' != '' and Exists('$(KubunoApplicationIcon)')" />
    <_KubunoWin32ResourceInput Include="$(KubunoApplicationManifestFile)" Condition="'$(KubunoApplicationManifest)' == 'Custom' and '$(KubunoApplicationManifestFile)' != '' and Exists('$(KubunoApplicationManifestFile)')" />
  </ItemGroup>

  <!--
    KubunoWin32Resources: generates the Win32 .res (icon, application manifest, version information)
    that CoreCompile links into the executable through cargo rustc (link-arg for the bin only) -
    no build.rs or crate dependency in the developer's package. Empty version fields fall back to
    Cargo.toml's [package] version/name/description/authors (read by the task).
  -->
  <Target Name="KubunoWin32Resources" Condition="'$(_KubunoWin32ResourcesEnabled)' == 'true'">
    <PropertyGroup>
      <_KubunoWin32ResourceFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'kubuno_win32_{hash}.res'))</_KubunoWin32ResourceFile>
      <_KubunoWin32Icon Condition="'$(KubunoApplicationIcon)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(KubunoApplicationIcon)'))</_KubunoWin32Icon>
      <_KubunoWin32CustomManifest Condition="'$(KubunoApplicationManifestFile)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(KubunoApplicationManifestFile)'))</_KubunoWin32CustomManifest>
    </PropertyGroup>
    <KubunoWin32Resources OutputFile="$(_KubunoWin32ResourceFile)"
                          CargoManifestPath="$(CargoManifestPath)"
                          IconFile="$(_KubunoWin32Icon)"
                          ManifestMode="$(KubunoApplicationManifest)"
                          CustomManifestFile="$(_KubunoWin32CustomManifest)"
                          DpiAwareness="$(KubunoDpiAwareness)"
                          ExecutionLevel="$(KubunoExecutionLevel)"
                          MinimumWindowsVersion="$(KubunoMinimumWindowsVersion)"
                          LongPathAware="$(KubunoLongPathAware)"
                          CommonControlsV6="$(KubunoCommonControlsV6)"
                          FileVersion="$(KubunoFileVersion)"
                          ProductVersion="$(KubunoProductVersion)"
                          ProductName="$(KubunoProductName)"
                          CompanyName="$(KubunoCompanyName)"
                          FileDescription="$(KubunoFileDescription)"
                          Copyright="$(KubunoCopyright)"
                          Trademarks="$(KubunoTrademarks)"
                          OriginalFilename="$(_KubunoBinName).exe"
                          InternalName="$(_KubunoBinName)">
      <Output TaskParameter="ResourceFile" PropertyName="_KubunoWin32ResourcePath" />
    </KubunoWin32Resources>
    <ItemGroup>
      <_KubunoLinkArg Include="$(_KubunoWin32ResourcePath)" />
    </ItemGroup>
  </Target>

  <!-- The rustc flags (an item list is only usable inside a target). -->
  <Target Name="_KubunoComputeRustFlags">
    <PropertyGroup>
      <_KubunoRustFlags>$(RustFlags)</_KubunoRustFlags>
      <_KubunoRustFlags Condition="'$(RustWarningsAsErrors)' == 'true'">$(_KubunoRustFlags) -D warnings</_KubunoRustFlags>
      <_KubunoRustFlags Condition="'@(_KubunoRustCfg)' != ''">$(_KubunoRustFlags) @(_KubunoRustCfg->'--cfg %(Identity)', ' ')</_KubunoRustFlags>
      <_KubunoRustFlags>$(_KubunoRustFlags.Trim())</_KubunoRustFlags>
    </PropertyGroup>
  </Target>

  <Target Name="CreateManifestResourceNames" />

  <!--
    CoreCompile (docs/RSPROJ.md Â§2): the load-bearing override, the same documented seam the JS SDK
    uses â€” Microsoft.Common's Build/CoreBuild/Compile chain calls it but never defines it. Runs cargo
    build with the json-diagnostic-rendered-ansi message format, parsed by CargoBuild into clickable
    Error List entries (Kubuno.Cargo.MSBuild.Tasks â€” work package 2). Defined BEFORE the
    Microsoft.Common.targets import on purpose (a later definition of the same name would win).
  -->
  <Target Name="CoreCompile"
          DependsOnTargets="CargoRestore;_KubunoComputeRustFlags;KubunoWin32Resources"
          Inputs="$(MSBuildProjectFullPath);$(CargoManifestPath);@(_KubunoCargoLockFile);@(_KubunoCargoSourceFiles);@(_KubunoWin32ResourceInput);@(_KubunoLinkArg)"
          Outputs="$(TargetPath)">
    <!-- With Win32 resources the bin is named explicitly: `cargo rustc` needs exactly one target. -->
    <PropertyGroup>
      <_KubunoBuildBin>$(CargoBin)</_KubunoBuildBin>
      <_KubunoBuildBin Condition="'$(_KubunoBuildBin)' == '' and '@(_KubunoLinkArg)' != ''">$(_KubunoBinName)</_KubunoBuildBin>
    </PropertyGroup>
    <CargoBuild ManifestPath="$(CargoManifestPath)"
                Package="$(CargoPackage)"
                Profile="$(CargoProfile)"
                TargetDir="$(CargoTargetDir)"
                Bin="$(_KubunoBuildBin)"
                Features="@(_KubunoCargoFeature)"
                NoDefaultFeatures="$(CargoNoDefaultFeatures)"
                AllFeatures="$(CargoAllFeatures)"
                TargetTriple="$(CargoTargetTriple)"
                RustFlags="$(_KubunoRustFlags)"
                LinkArgs="@(_KubunoLinkArg)"
                ExtraArgs="$(CargoExtraArgs)"
                WorkingDirectory="$(_KubunoManifestDir)">
      <Output TaskParameter="ExecutablePath" PropertyName="TargetPath" />
    </CargoBuild>
    <PropertyGroup>
      <TargetDir>$([System.IO.Path]::GetDirectoryName('$(TargetPath)'))\</TargetDir>
    </PropertyGroup>
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.targets" />

  <!--
    CargoRestore (docs/RSPROJ.md Â§2): `cargo fetch`, a NuGet-free restore, hooked after NuGet's own
    Restore target the same way the JS SDK hooks NPMRestore â€” so both `msbuild -t:Restore` and
    `dotnet build`'s implicit restore run it. Also a dependency of CoreCompile.
  -->
  <Target Name="CargoRestore" AfterTargets="Restore">
    <CargoFetch ManifestPath="$(CargoManifestPath)" TargetDir="$(CargoTargetDir)" WorkingDirectory="$(_KubunoManifestDir)" />
  </Target>

  <!--
    KubunoClippy (Code Analysis page, "Run Clippy on build"): `cargo clippy` over the package after a
    successful compile, with the same profile/features/target; its lints reach the Error List like
    compiler warnings. Lint levels come from Cargo.toml's [lints] table.
  -->
  <Target Name="KubunoClippy" AfterTargets="CoreCompile" DependsOnTargets="_KubunoComputeRustFlags" Condition="'$(KubunoClippyOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <CargoClippy ManifestPath="$(CargoManifestPath)"
                 Package="$(CargoPackage)"
                 Profile="$(CargoProfile)"
                 TargetDir="$(CargoTargetDir)"
                 Features="@(_KubunoCargoFeature)"
                 NoDefaultFeatures="$(CargoNoDefaultFeatures)"
                 AllFeatures="$(CargoAllFeatures)"
                 TargetTriple="$(CargoTargetTriple)"
                 RustFlags="$(_KubunoRustFlags)"
                 WorkingDirectory="$(_KubunoManifestDir)" />
  </Target>

  <Target Name="_KubunoReportTargetPath" AfterTargets="CoreBuild" Condition="Exists('$(TargetPath)')">
    <Message Text="$(MSBuildProjectName) -&gt; $(TargetPath)" Importance="High" />
  </Target>

  <!--
    Clean: `cargo clean` for the current profile, hooked before Microsoft.Common's own Clean (the
    JS SDK's _CleanBuildOutput pattern), so Build/Rebuild/Clean all keep their standard definitions.
  -->
  <Target Name="_KubunoCargoClean" BeforeTargets="BeforeClean">
    <PropertyGroup>
      <!-- Always name the profile: a bare `cargo clean` wipes the WHOLE target dir, i.e. the other
           configuration's (and, with a shared CARGO_TARGET_DIR, other packages') artifacts too. -->
      <_KubunoCleanProfileArg Condition="'$(CargoProfile)' == 'debug'">--profile dev</_KubunoCleanProfileArg>
      <_KubunoCleanProfileArg Condition="'$(CargoProfile)' == 'release'">--release</_KubunoCleanProfileArg>
      <_KubunoCleanProfileArg Condition="'$(CargoProfile)' != 'release' and '$(CargoProfile)' != 'debug'">--profile $(CargoProfile)</_KubunoCleanProfileArg>
      <_KubunoCleanProfileArg Condition="'$(CargoTargetTriple)' != ''">$(_KubunoCleanProfileArg) --target $(CargoTargetTriple)</_KubunoCleanProfileArg>
    </PropertyGroup>
    <Exec Command="cargo clean --manifest-path &quot;$(CargoManifestPath)&quot; $(_KubunoCleanProfileArg)"
          WorkingDirectory="$(_KubunoManifestDir)"
          EnvironmentVariables="CARGO_TARGET_DIR=$(CargoTargetDir)"
          Condition="'$(CargoTargetDir)' != ''" />
    <Exec Command="cargo clean --manifest-path &quot;$(CargoManifestPath)&quot; $(_KubunoCleanProfileArg)"
          WorkingDirectory="$(_KubunoManifestDir)"
          Condition="'$(CargoTargetDir)' == ''" />
  </Target>

  <!--
    PrepareForBuild override (as in the JS SDK): Microsoft.Common's version creates the output
    folders for a managed assembly; cargo creates its own, and a Common-created OutDir inside a
    not-yet-existing CARGO_TARGET_DIR is pointless.
  -->
  <Target Name="PrepareForBuild" DependsOnTargets="$(PrepareForBuildDependsOn)" />

  <!-- No managed references to resolve for a Rust project (docs/RSPROJ.md Â§2's "Stubs"). -->
  <Target Name="ResolveAssemblyReferences" Returns="" DependsOnTargets="$(ResolveAssemblyReferencesDependsOn)" />
  <Target Name="GetReferenceAssemblyPaths" />
  <Target Name="GetFrameworkPaths" />
  <PropertyGroup>
    <_TargetFrameworkDirectories />
    <FrameworkPathOverride />
    <TargetFrameworkDirectory />
  </PropertyGroup>

  <!-- Design-time build (docs/RSPROJ.md Â§3/Â§6): never shells out to cargo â€” CPS only needs the
       evaluated items/properties, so this is a well-formed no-op. -->
  <Target Name="CompileDesignTime" />

  <!--
    Run (docs/RSPROJ.md Â§2): `cargo run` â€” a plain Exec, not the diagnostics-aware CargoBuild task:
    a running program's own stdout/stderr must reach the console byte-for-byte.
  -->
  <Target Name="Run">
    <PropertyGroup>
      <_KubunoRunBinArg Condition="'$(CargoBin)' != ''">--bin $(CargoBin)</_KubunoRunBinArg>
      <_KubunoRunProfileArg Condition="'$(CargoProfile)' == 'release'">--release</_KubunoRunProfileArg>
      <_KubunoRunProfileArg Condition="'$(CargoProfile)' != 'release' and '$(CargoProfile)' != 'debug'">--profile $(CargoProfile)</_KubunoRunProfileArg>
      <_KubunoRunProfileArg Condition="'$(CargoTargetTriple)' != ''">$(_KubunoRunProfileArg) --target $(CargoTargetTriple)</_KubunoRunProfileArg>
    </PropertyGroup>
    <Exec Command="cargo run --manifest-path &quot;$(CargoManifestPath)&quot; $(_KubunoRunBinArg) $(_KubunoRunProfileArg) $(CargoExtraArgs)"
          WorkingDirectory="$(_KubunoManifestDir)"
          EnvironmentVariables="CARGO_TARGET_DIR=$(CargoTargetDir)"
          Condition="'$(CargoTargetDir)' != ''" />
    <Exec Command="cargo run --manifest-path &quot;$(CargoManifestPath)&quot; $(_KubunoRunBinArg) $(_KubunoRunProfileArg) $(CargoExtraArgs)"
          WorkingDirectory="$(_KubunoManifestDir)"
          Condition="'$(CargoTargetDir)' == ''" />
  </Target>

  <!-- Test (Kubuno.Cargo.MSBuild.Tasks' CargoTest â€” work package 2): same diagnostics treatment as Build. -->
  <Target Name="Test" DependsOnTargets="_KubunoComputeRustFlags">
    <CargoTest ManifestPath="$(CargoManifestPath)"
               Package="$(CargoPackage)"
               Profile="$(CargoProfile)"
               TargetDir="$(CargoTargetDir)"
               Features="@(_KubunoCargoFeature)"
               NoDefaultFeatures="$(CargoNoDefaultFeatures)"
               AllFeatures="$(CargoAllFeatures)"
               TargetTriple="$(CargoTargetTriple)"
               RustFlags="$(_KubunoRustFlags)"
               ExtraArgs="$(CargoExtraArgs)"
               WorkingDirectory="$(_KubunoManifestDir)" />
  </Target>

</Project>
