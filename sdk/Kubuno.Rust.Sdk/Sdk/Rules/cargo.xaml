<?xml version="1.0" encoding="utf-8"?>
<!-- "Cargo" project property page (docs/RSPROJ.md §3): the Kubuno.Rust.Sdk properties a .rsproj may
     set. Debug/launch settings are work package 4. -->
<Rule Name="CargoProperties"
      DisplayName="Cargo"
      PageTemplate="generic"
      Description="Cargo package built by this project"
      Order="100"
      xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.Categories>
    <Category Name="Cargo" DisplayName="Cargo" />
  </Rule.Categories>
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="False" />
  </Rule.DataSource>
  <StringProperty Name="CargoPackage" DisplayName="Package" Category="Cargo"
                  Description="Name of the Cargo package (cargo -p) this project builds. Empty: the package of the manifest." />
  <StringProperty Name="CargoBin" DisplayName="Binary target" Category="Cargo"
                  Description="The [[bin]] target to build and run (cargo --bin). Empty: the default binary chosen by cargo." />
  <StringProperty Name="CargoManifestPath" DisplayName="Manifest path" Category="Cargo" Subtype="file"
                  Description="Path of the Cargo.toml (cargo --manifest-path). Default: the Cargo.toml next to the project file." />
  <StringProperty Name="CargoTargetDir" DisplayName="Target directory" Category="Cargo" Subtype="folder"
                  Description="Cargo target directory. Default: the CARGO_TARGET_DIR environment variable, else the cargo default." />
  <StringProperty Name="CargoExtraArgs" DisplayName="Extra arguments" Category="Cargo"
                  Description="Additional arguments appended verbatim to cargo build/test/run." />
</Rule>
