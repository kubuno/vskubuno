<?xml version="1.0" encoding="utf-8"?>
<!-- Item-level general properties for any file of the project (same shape as the JS SDK's). -->
<Rule Name="ConfigurationGeneralFile"
      DisplayName="General"
      PageTemplate="generic"
      Description="Project item general properties"
      xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="False" ItemType="{}{AnyType}" />
  </Rule.DataSource>
  <DynamicEnumProperty Name="{}{ItemType}" DisplayName="Item Type"
                       Description="Item type determines the build tool of the file"
                       EnumProvider="ItemTypes" />
  <StringProperty Name="DependentUpon" Visible="False" />
  <BoolProperty Name="Visible" Visible="False" />
  <StringProperty Name="Link" Visible="False" />
</Rule>
