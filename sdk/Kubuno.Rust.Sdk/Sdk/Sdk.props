<Project>

  <!--
    Kubuno.Rust.Sdk — pure MSBuild SDK for a .rsproj (docs/RSPROJ.md work package 1). Modeled on
    Microsoft.VisualStudio.JavaScript.SDK: a project using this SDK never lists .rs files or
    repeats [dependencies] — it names one Cargo package (<CargoPackage>) and otherwise defers to
    Cargo itself. This file (the implicit TOP import of `<Project Sdk="Kubuno.Rust.Sdk/…">`) only
    sets defaults; Sdk.targets (the implicit BOTTOM import) does the actual work, since several
    defaults (CargoProfile in particular) depend on properties (Configuration) the project body may
    still set after this file runs.

    Like the JS SDK, this SDK sits on top of Microsoft.Common.props/.targets (imported here and at
    the bottom of Sdk.targets): Visual Studio's Common Project System (work package 3) drives a
    project through that standard targets graph — design-time builds, solution Build/Rebuild/Clean,
    project configurations, output groups — so cargo is plugged into its documented extension
    points (CoreCompile, BeforeClean, Restore) instead of redefining Build/Clean/Rebuild. (Work
    package 1 first shipped without Microsoft.Common; that was enough for the command line but not
    for CPS, which calls targets such as GetTargetPath/BuiltProjectOutputGroup/ResolveReferences
    through their Microsoft.Common definitions.)
  -->

  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="'$(MicrosoftCommonPropsHasBeenImported)' != 'true' and Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <!-- Standard MSBuild defaults every project is expected to have — a .sln's
         ProjectConfigurationPlatforms section, and `-p:Configuration=Release`, both assume these. -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- A Rust executable is native code for one architecture: x64 is the only platform offered and
         maps to the x86_64-pc-windows-msvc host triple (no cargo target flag, so artifacts stay in
         cargo's default <target dir>\<profile>, where Kubuno.Launch expects them). -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>

    <!-- The CPS debugger used for F5/Ctrl+F5 (docs/RSPROJ.md work package 4): the name
         Kubuno.VisualStudio.RustProjectSystem's RustDebugLaunchProvider is exported under, the same
         way the JS SDK sets ScriptDebugger. -->
    <DebuggerFlavor Condition="'$(DebuggerFlavor)' == ''">RustDebugger</DebuggerFlavor>

    <!-- A fake, unused target framework so `dotnet build`/`dotnet restore` recognize this as a
         project worth evaluating at all (the JS SDK's own documented trick — docs/RSPROJ.md §2).
         Never used to resolve any actual .NET reference (NoStdLib below). -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net6.0</TargetFramework>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''"></TargetFrameworks>
    <TargetFrameworkVersion>v6.0</TargetFrameworkVersion>
    <TargetFrameworkMoniker>.NETCoreApp,Version=v6.0</TargetFrameworkMoniker>
    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
    <TargetPlatformIdentifier>None</TargetPlatformIdentifier>
    <TargetPlatformMoniker>None</TargetPlatformMoniker>

    <!-- No managed compilation happens for a .rsproj: cargo is the only compiler. -->
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- Project-type GUID for `.rsproj` (docs/RSPROJ.md §3): the key Kubuno.VisualStudio's
         rsproj.pkgdef registers the CPS project factory under (work package 3). -->
    <DefaultProjectTypeGuid Condition="'$(DefaultProjectTypeGuid)' == ''">{6C7C4CB5-6E36-4C6F-9C6F-9C6E9B4D4C13}</DefaultProjectTypeGuid>

    <!-- Cargo.toml is the single source of truth (docs/RSPROJ.md §1): default to the manifest
         sitting right next to the .rsproj. A workspace member project overrides this explicitly. -->
    <CargoManifestPath Condition="'$(CargoManifestPath)' == ''">$(MSBuildProjectDirectory)\Cargo.toml</CargoManifestPath>

    <!-- CARGO_TARGET_DIR convention (CLAUDE.md §5): an explicit MSBuild property always wins;
         otherwise fall back to the environment variable of the same name; when neither is set,
         leave it empty so cargo resolves its own default (`<manifest dir>/target` or
         `.cargo/config.toml`'s `build.target-dir`) instead of guessing it here. -->
    <CargoTargetDir Condition="'$(CargoTargetDir)' == '' and '$(CARGO_TARGET_DIR)' != ''">$(CARGO_TARGET_DIR)</CargoTargetDir>

    <!-- Which [[bin]] to build/run when a package declares more than one; empty means "let cargo
         decide" (its own default-run/only-bin/first-bin fallback chain). -->
    <CargoBin Condition="'$(CargoBin)' == ''"></CargoBin>

    <!-- Extra, verbatim cargo arguments a project can append (e.g. the locked/frozen flags). -->
    <CargoExtraArgs Condition="'$(CargoExtraArgs)' == ''"></CargoExtraArgs>

    <!--
      The task assembly this SDK ships (work package 2) — resolved relative to this very file,
      exactly like the JS SDK locates its own task DLL. Two TFMs are shipped side by side, picked by
      $(MSBuildRuntimeType) ("Full" = the .NET Framework MSBuild.exe VS ships; anything else = the
      .NET host `dotnet build` uses) — a plain netstandard2.0 task assembly does NOT load under the
      .NET host (see Kubuno.Cargo.MSBuild.Tasks.csproj's own comment).
    -->
    <_KubunoCargoTasksTfm Condition="'$(_KubunoCargoTasksTfm)' == '' and '$(MSBuildRuntimeType)' == 'Full'">net472</_KubunoCargoTasksTfm>
    <_KubunoCargoTasksTfm Condition="'$(_KubunoCargoTasksTfm)' == ''">net10.0</_KubunoCargoTasksTfm>
    <_KubunoCargoTasksAssembly Condition="'$(_KubunoCargoTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\tasks\$(_KubunoCargoTasksTfm)\Kubuno.Cargo.MSBuild.Tasks.dll</_KubunoCargoTasksAssembly>
  </PropertyGroup>

  <!--
    Default items (docs/RSPROJ.md §3 "File globbing"), mirroring the JS SDK's own Sdk.props: every
    file under the project folder becomes a None item, purely so Solution Explorer has something to
    show — cargo compiles, MSBuild only displays, so nothing is ever a Compile item. Items are
    evaluated after every property, so EnableDefaultItems/DefaultItemExcludes (set in Sdk.targets,
    overridable by the project) already have their final values here. .kbview files fall out of
    this glob and open with the extension's own editor factory (dispatch is by file extension, not
    by project type).
  -->
  <ItemGroup Condition="'$(EnableDefaultItems)' == 'true' and '$(EnableDefaultNoneItems)' == 'true'">
    <None Include="**/*" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

</Project>
