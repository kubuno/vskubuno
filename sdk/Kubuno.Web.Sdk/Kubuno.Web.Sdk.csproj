<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packages Kubuno.Web.Sdk (docs/WEB.md) as a NuGet MSBuildSdk package: an ADDITIONAL SDK a project names next to its
    main one - `<Sdk Name="Kubuno.Web.Sdk" Version="1.0.1" />` in the .rsproj of the core or of a module
    (Kubuno.Rust.Sdk) and in the .esproj of a frontend (Microsoft.VisualStudio.JavaScript.Sdk). Pure MSBuild
    (Sdk/Sdk.props, Sdk/Sdk.targets, Sdk/Rules) plus its task assembly, Kubuno.Web.MSBuild.Tasks, built by this
    project (unlike Kubuno.Rust.Sdk's, no manual staging step) and packed under tasks\<tfm>.

      dotnet pack sdk\Kubuno.Web.Sdk\Kubuno.Web.Sdk.csproj -c Release -o <feed folder>

    Shipped inside the VSIX next to Kubuno.Rust.Sdk (tools\SdkFeed) and copied into a generated solution's own feed
    (.kubuno\sdk-feed), so a checkout restores it without the extension loaded.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Kubuno.Web.Sdk</PackageId>
    <Version>1.0.1</Version>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <Authors>Kubuno</Authors>
    <Description>Additional MSBuild SDK for Kubuno web projects: dev core F5 with the development database guard, module deployment and .kbpkg packaging for a .rsproj; Windows node environment for a frontend .esproj.</Description>
    <_KubunoWebTasksProject>..\..\src\Web\Kubuno.Web.MSBuild.Tasks\Kubuno.Web.MSBuild.Tasks.csproj</_KubunoWebTasksProject>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk\**" Pack="true" PackagePath="Sdk\" />
  </ItemGroup>

  <Target Name="_KubunoWebPackTasks" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="$(_KubunoWebTasksProject)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net472" />
    <MSBuild Projects="$(_KubunoWebTasksProject)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
    <ItemGroup>
      <_KubunoWebTaskNet472 Include="..\..\src\Web\Kubuno.Web.MSBuild.Tasks\bin\$(Configuration)\net472\*.dll" />
      <_KubunoWebTaskNet10 Include="..\..\src\Web\Kubuno.Web.MSBuild.Tasks\bin\$(Configuration)\net10.0\*.dll;..\..\src\Web\Kubuno.Web.MSBuild.Tasks\bin\$(Configuration)\net10.0\*.deps.json" />
      <None Include="@(_KubunoWebTaskNet472)" Pack="true" PackagePath="tasks\net472\" />
      <None Include="@(_KubunoWebTaskNet10)" Pack="true" PackagePath="tasks\net10.0\" />
    </ItemGroup>
  </Target>

</Project>
