<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DSG-7 spike (docs/DESIGNER.md): a standalone WPF window hosting the Rust
    view surface (view_embed.exe, another process) through an HwndHost.
    Deliberately NOT part of Kubuno.VisualStudio.sln. net48 on purpose: it is
    the runtime the VSIX itself runs on inside devenv.exe.

    Now drives the PRODUCTION host class (`Kubuno.VisualStudio.Designer.
    DesignSurface.RustDesignSurfaceHost`) instead of the spike's own
    `DesignSurfaceHost` (removed - superseded): this project is what the
    selftest flag is run against to verify DSG-7's production code (job
    object, restart backoff, error mode, DLL check, keyboard protocol)
    without needing a live devenv.exe. `Native.cs` stays: it drives synthetic
    input and inspects windows/processes for the test itself, which is a
    different concern from the host's own plumbing (now in the referenced
    project's `DesignSurface/NativeMethods.cs`). The `ProjectReference` alone
    does not pull `Kubuno.VisualStudio.Designer` into `Kubuno.VisualStudio.
    sln` (it is a plain MSBuild project-to-project reference); that library's
    own `Microsoft.VisualStudio.SDK` package is `ExcludeAssets="runtime"`, so
    nothing here needs devenv.exe's assemblies to run standalone - confirmed
    by this spike actually running outside VS.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>HwndHostSpike</RootNamespace>
    <StartupObject>HwndHostSpike.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kubuno.VisualStudio.Designer\Kubuno.VisualStudio.Designer.csproj" />
  </ItemGroup>

</Project>
