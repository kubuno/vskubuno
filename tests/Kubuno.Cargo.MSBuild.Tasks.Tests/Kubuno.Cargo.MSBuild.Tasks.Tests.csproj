<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- See Kubuno.Cargo.MSBuild.Tasks.csproj's own comment: NU1903 has no resolving version today. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      Unlike the shipped task assembly (which excludes the runtime assets — see
      Kubuno.Cargo.MSBuild.Tasks.csproj's own comment), `dotnet test`'s VSTest host is not
      MSBuild.exe and has no Microsoft.Build.* assemblies loaded on its own, so this project needs
      the real runtime assemblies copied to its own output to execute at all.
    -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kubuno.Cargo\Kubuno.Cargo.csproj" />
    <ProjectReference Include="..\..\src\Kubuno.Cargo.MSBuild.Tasks\Kubuno.Cargo.MSBuild.Tasks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real captured cargo build message-format json-diagnostic-rendered-ansi output, shared with Kubuno.Cargo.Tests. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
