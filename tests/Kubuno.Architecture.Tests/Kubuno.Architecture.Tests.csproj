<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The layering rules of the extension (docs/ARCHITECTURE.md, "Layers (as built)"), checked on the sources (every
    ProjectReference of src/**/*.csproj) and on the built assemblies (their assembly references, read with
    System.Reflection.Metadata without loading them): Shared <- Rust <- Views <- Desktop / Web / Mobile, the three targets never
    reference each other, the *.Logic assemblies never reference the Visual Studio SDK, every product layer registers one
    KubunoLayer and the packaging project ships them all.

    It reads the assemblies from each project's own bin\<Configuration>\ folder, so the solution builds it last
    (a ProjectDependencies entry of Kubuno.VisualStudio.sln, not a ProjectReference: building it must not build the
    VSIX project, which needs Visual Studio's MSBuild).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kubuno.Architecture.Tests</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
