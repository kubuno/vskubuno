<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the Core layer (docs/ARCHITECTURE.md, "Layers (as built)"): the pure helpers of Kubuno.Core.Logic (LSP
       plumbing, UI language) and the unified settings manifest every layer's options pages are declared in. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kubuno.Core.Tests</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Kubuno.Core.Logic\Kubuno.Core.Logic.csproj" />
  </ItemGroup>

</Project>