<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kubuno.VisualStudio.Designer.Tests</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!--
      See .runsettings (same folder) and its own comment: works around .NET Framework's
      loader-from-remote-source restriction on a mapped network drive (e.g. Z:), which otherwise
      fails MSTest.TestAdapter.dll's own load for every test in this net48 project. Picked up by
      both `dotnet test` and VS's Test Explorer automatically - no shell environment variable to
      remember.
    -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
    <!--
      Selection/Fakes/FakeDesignSurfaceHost.cs (IDesignSurfaceHost's own Content : FrameworkElement)
      needs WPF - a plain net48 SDK-style project does not reference PresentationCore/
      PresentationFramework/WindowsBase by default the way the old-style VSIX/Designer library
      projects do (see their own csproj <Reference> items); UseWPF is the SDK-style equivalent.
    -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <!--
      Kubuno.VisualStudio.Designer.csproj itself only gets System.Text.Json (used by
      Registry/Serialization/*) transitively through Microsoft.VisualStudio.SDK, whose
      ExcludeAssets="runtime" (see that csproj's own PackageReference comment - devenv.exe supplies
      those assemblies at runtime, so the VSIX never ships its own copy) cascades to every package it
      pulls in, System.Text.Json included. That is fine inside devenv.exe, but this test project runs
      as a plain net48 executable with no devenv.exe to supply it, so System.Text.Json's own DLL would
      otherwise be missing from the test output directory (FileNotFoundException at run time, not a
      build error). Referencing it here directly - at the SAME version Microsoft.VisualStudio.SDK
      already resolves to, not a lower one - forces its runtime assets to actually deploy, without
      triggering the "explicit downgrade" NU1605-as-error this repo already documents elsewhere
      (src/Kubuno.Mcp.Bridge/Kubuno.Mcp.Bridge.csproj's own PackageReference comment) for an SDK-style
      project that pins a LOWER version than what flows in transitively.
    -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      References the whole library: this test project exercises both the VS-SDK-free view-models
      (UI/DesignerSplitViewModel.cs, Toolbox/*, Properties/*, Registry/* - all plain unit-testable) and
      the pure Editing/* pieces DSG-5 adds (LspPositionMapper, TextEditPlanner, BufferEditCore,
      CompoundEditCoordinator - see tests/.../Editing/). Everything else in this library (the editor
      factory, DesignerWindowPane, CodeWindowHost, and Editing/Infrastructure/*'s real
      ITextBuffer/ITextUndoHistory adapters) either needs a live IVsTextLines/IVsCodeWindow/ITextBuffer
      COM/editor object or a hosted WPF Dispatcher/visual tree it only gets inside a real devenv.exe
      process - see those classes' own doc comments, and INTEGRATION.md/docs/DESIGNER.md's DSG-3/DSG-5
      rows ("Manual, experimental instance - visual check" / "manual Ctrl+Z check"), for why those stay
      out of this project.
    -->
    <ProjectReference Include="..\..\src\Kubuno.VisualStudio.Designer\Kubuno.VisualStudio.Designer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A checked-in, schema-faithful registry.sample.json (docs/DESIGNER.md §5) for Registry/ComponentRegistryTests.cs and the Toolbox/Properties view-model tests - not real kubuno-views output (DSG-1 hasn't landed), copied next to the test assembly like tests/Kubuno.Cargo.Tests' own Fixtures/. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
