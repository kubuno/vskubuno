<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the Rust layer's pure logic (docs/ARCHITECTURE.md, "Layers (as built)"): Kubuno.Rust.Logic, and the panic
       payload decoder of Kubuno.Rust.Debugger. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kubuno.Rust.Tests</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rust\Kubuno.Rust.Logic\Kubuno.Rust.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The panic payload decoder of the Concord component (docs/DEBUGGING.md), pure logic over a memory reader; the
         component assembly itself references the debugger engine of the Visual Studio install. -->
    <Compile Include="..\..\src\Rust\Kubuno.Rust.Debugger\RustPanicPayload.cs" Link="Debugging\RustPanicPayload.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real `cargo metadata` captures shared with Kubuno.Rust.Cargo.Tests (Dependencies node mapping). -->
    <None Include="..\Kubuno.Rust.Cargo.Tests\Fixtures\Metadata\dependencies-*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real rust-analyzer 1.98 textDocument/hover markdown (QuickInfo conversion tests). -->
    <None Update="Fixtures\Hover\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
