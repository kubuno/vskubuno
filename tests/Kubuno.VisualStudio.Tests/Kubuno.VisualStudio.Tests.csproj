<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kubuno.VisualStudio.Tests</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kubuno.VisualStudio.Core\Kubuno.VisualStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The item-template wizard's pure naming and module logic (docs/EVENTS.md EVT-7b), compiled here on its own:
         the wizard assembly itself references Visual Studio install assemblies. -->
    <Compile Include="..\..\src\Kubuno.VisualStudio.TemplateWizard\ControlItemNames.cs" Link="Wizard\ControlItemNames.cs" />
    <!-- The panic payload decoder of the Concord component (docs/DEBUGGING.md), pure logic over a memory reader; the
         component assembly itself references the debugger engine of the Visual Studio install. -->
    <Compile Include="..\..\src\Kubuno.VisualStudio.Debugger\RustPanicPayload.cs" Link="Debugging\RustPanicPayload.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real `cargo metadata` captures shared with Kubuno.Cargo.Tests (Dependencies node mapping). -->
    <None Include="..\Kubuno.Cargo.Tests\Fixtures\Metadata\dependencies-*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real rust-analyzer 1.98 textDocument/hover markdown (QuickInfo conversion tests). -->
    <None Update="Fixtures\Hover\*.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- kubuno-data-tool schema.load answers (Data Explorer tree tests, docs/DATA.md DATA-5). -->
    <None Update="Data\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Schema snapshots in the `schema.load` format (docs/DATA.md DATA-8: SQL IntelliSense in Rust strings). -->
    <None Update="Fixtures\Sql\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- A real kubuno-data-tool migrate.status answer, paths normalized (docs/DATA.md DATA-7: the Migrations node). -->
    <None Update="Migrations\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
