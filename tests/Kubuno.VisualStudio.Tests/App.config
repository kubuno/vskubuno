<?xml version="1.0" encoding="utf-8"?>
<!--
  Z:\projects\kubuno is a mapped drive; .NET Framework's CAS zone detection treats mapped drives
  as "remote" and refuses to load assemblies from them by default (FileLoadException,
  HRESULT 0x80131515), which breaks the MSTest test adapter and the testhost itself. This applies
  the same fix VS's own devenv.exe.config uses for the same reason.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
