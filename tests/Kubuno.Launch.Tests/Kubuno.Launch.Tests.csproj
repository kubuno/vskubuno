<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs with plain `dotnet test`, no Visual Studio host required. Targets net8.0 (an
    installed LTS runtime) rather than netstandard2.0 — a netstandard TFM can't itself
    produce a runnable test executable; the library under test stays netstandard2.0.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Kubuno.Launch.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kubuno.Launch\Kubuno.Launch.csproj" />
  </ItemGroup>

</Project>
