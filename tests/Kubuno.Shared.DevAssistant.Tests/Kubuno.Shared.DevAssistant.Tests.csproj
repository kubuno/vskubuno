<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the Kubuno Dev Assistant (docs/AI-ASSISTANT.md lot DA-1): the protocol, secret scanning and masking, the
    change sets (diff, hunks, staleness, one-undo application), the cost cap, the tool policy, the Anthropic provider
    against a local server replaying recorded SSE, and the whole /vue flow through the host with the fake provider.
    No test calls a real API or needs a key. net8.0: it drives the net8 host in-process.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kubuno.Shared.DevAssistant.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Kubuno.Shared.DevAssistant.Logic\Kubuno.Shared.DevAssistant.Logic.csproj" />
    <ProjectReference Include="..\..\src\Shared\Kubuno.Shared.DevAssistant.Host\Kubuno.Shared.DevAssistant.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
