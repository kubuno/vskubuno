# Line-ending policy (MULTI-OS-AUDIT C30), Visual Studio variant.
#
# The repository stores text files with LF. This repository is Windows-only, so
# C#, XAML and project files follow core.autocrlf on checkout; the types listed
# below are checked out with LF everywhere because their bytes are hashed or
# embedded (SQL migrations, Rust sources, TOML manifests, web assets).
* text=auto

# SQL migrations: sqlx::migrate! embeds a SHA-384 of each file's bytes. A CRLF
# checkout changes the checksum, and a database migrated by a build made on
# another OS is then refused (VersionMismatch). Never let these become CRLF.
*.sql       text eol=lf

# Shell scripts, Makefiles, Dockerfiles, Python: interpreters choke on CR.
*.sh        text eol=lf
*.py        text eol=lf
Makefile    text eol=lf
Dockerfile* text eol=lf

# Manifests and configuration: module.toml and config examples are copied into
# the .kbpkg and covered by its SHA256SUMS; Cargo files would otherwise churn.
*.toml      text eol=lf
*.lock      text eol=lf
*.example   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Rust sources: include_str!/include_bytes! embed source files and fixtures.
*.rs        text eol=lf

# Frontend sources and build inputs: the bundle must be byte-identical
# whichever OS builds it.
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# Documentation: READMEs and CHANGELOGs are published as-is (release notes).
*.md        text eol=lf

# Windows command scripts: cmd.exe mis-parses labels and GOTO targets with LF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets and packages: never convert, never diff as text.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.bmp       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tgz       binary
*.xz        binary
*.zst       binary
*.7z        binary
*.tar       binary
*.jar       binary
*.wasm      binary
*.bdic      binary
*.nupkg     binary
*.vsix      binary
*.kbpkg     binary
*.deb       binary
*.rpm       binary
*.msi       binary
*.exe       binary
*.dll       binary
*.pdb       binary
*.so        binary
*.dylib     binary

# Visual Studio solution files: Visual Studio rewrites them with CRLF.
*.sln       text eol=crlf
